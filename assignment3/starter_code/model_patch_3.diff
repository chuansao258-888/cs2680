+// indexExists returns whether the given table has a global secondary index
+// with the given name.
+func (l *Log) indexExists(tableName, indexName string) (bool, error) {
+	out, err := l.svc.DescribeTable(&dynamodb.DescribeTableInput{
+		TableName: aws.String(tableName),
+	})
+	if err != nil {
+		return false, trace.Wrap(convertError(err))
+	}
+	if out == nil || out.Table == nil {
+		return false, nil
+	}
+	for _, index := range out.Table.GlobalSecondaryIndexes {
+		if index != nil && aws.StringValue(index.IndexName) == indexName {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// updateTable applies the current schema to an already existing table, i.e.
+// adds the global secondary indexes the table is missing.
+func (l *Log) updateTable(tableName string) error {
+	provisionedThroughput := dynamodb.ProvisionedThroughput{
+		ReadCapacityUnits:  aws.Int64(l.ReadCapacityUnits),
+		WriteCapacityUnits: aws.Int64(l.WriteCapacityUnits),
+	}
+	_, err := l.svc.UpdateTable(&dynamodb.UpdateTableInput{
+		TableName: aws.String(tableName),
+		AttributeDefinitions: []*dynamodb.AttributeDefinition{
+			{
+				AttributeName: aws.String(keyDate),
+				AttributeType: aws.String("S"),
+			},
+		},
+		GlobalSecondaryIndexUpdates: []*dynamodb.GlobalSecondaryIndexUpdate{
+			{
+				Create: &dynamodb.CreateGlobalSecondaryIndexAction{
+					IndexName: aws.String(indexTimeSearchV2),
+					KeySchema: []*dynamodb.KeySchemaElement{
+						{
+							AttributeName: aws.String(keyDate),
+							KeyType:       aws.String("HASH"),
+						},
+						{
+							AttributeName: aws.String(keyCreatedAt),
+							KeyType:       aws.String("RANGE"),
+						},
+					},
+					Projection: &dynamodb.Projection{
+						ProjectionType: aws.String("ALL"),
+					},
+					ProvisionedThroughput: &provisionedThroughput,
+				},
+			},
+		},
+	})
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	// Creating a global secondary index is an asynchronous operation, DynamoDB
+	// populates the index from the items already stored in the table.
+	log.Infof("Index %q is being created on table %q", indexTimeSearchV2, tableName)
+	return nil
+}
+
+// migrateDateAttribute backfills the normalized (ISO 8601 "yyyy-mm-dd") date
+// attribute on the events that were emitted before the attribute was
+// introduced. It scans over the whole table and updates every item, so that
+// all events - not only the ones emitted after the upgrade - can be found via
+// the date based search of indexTimeSearchV2.
+func (l *Log) migrateDateAttribute(ctx context.Context) error {
+	var lastEvaluatedKey map[string]*dynamodb.AttributeValue
+	for {
+		select {
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		default:
+		}
+
+		input := dynamodb.ScanInput{
+			TableName:         aws.String(l.Tablename),
+			ExclusiveStartKey: lastEvaluatedKey,
+		}
+		out, err := l.svc.ScanWithContext(ctx, &input)
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+
+		for _, item := range out.Items {
+			var e event
+			if err := dynamodbattribute.UnmarshalMap(item, &e); err != nil {
+				return trace.BadParameter("failed to unmarshal event: %v", err)
+			}
+			date := time.Unix(e.CreatedAt, 0).UTC().Format(iso8601DateFormat)
+			_, err := l.svc.UpdateItemWithContext(ctx, &dynamodb.UpdateItemInput{
+				TableName: aws.String(l.Tablename),
+				Key: map[string]*dynamodb.AttributeValue{
+					keySessionID:  item[keySessionID],
+					keyEventIndex: item[keyEventIndex],
+				},
+				UpdateExpression: aws.String("SET " + keyDate + " = :date"),
+				ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+					":date": {
+						S: aws.String(date),
+					},
+				},
+			})
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+		}
+
+		// AWS returns a `lastEvaluatedKey` in case the scan has not finished -
+		// the last page of a scan is signaled by not setting this value.
+		lastEvaluatedKey = out.LastEvaluatedKey
+		if len(lastEvaluatedKey) == 0 {
+			return nil
+		}
+	}
+}
