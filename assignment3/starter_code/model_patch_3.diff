+// daysBetween returns an inclusive list of ISO 8601 date strings ("yyyy-mm-dd")
+// covering every day from startTs through endTs, including ranges that span
+// month boundaries.
+func daysBetween(startTs, endTs time.Time) []string {
+	var dates []string
+	day := time.Date(startTs.Year(), startTs.Month(), startTs.Day(), 0, 0, 0, 0, time.UTC)
+	endDay := time.Date(endTs.Year(), endTs.Month(), endTs.Day(), 0, 0, 0, 0, time.UTC)
+	for !day.After(endDay) {
+		dates = append(dates, day.Format(iso8601DateFormat))
+		day = day.AddDate(0, 0, 1)
+	}
+	return dates
+}
