+// migrateDateAttribute walks all existing events and adds the CreatedAtDate
+// attribute so that previously stored events become queryable by date.
+// It uses Scan to enumerate items and UpdateItem to add the date to each one.
+// It honors cancellation via the supplied context and completes its whole pass
+// before returning.
+func (l *Log) migrateDateAttribute(ctx context.Context) error {
+	var lastEvaluatedKey map[string]*dynamodb.AttributeValue
+	for {
+		select {
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		default:
+		}
+
+		scanInput := &dynamodb.ScanInput{
+			TableName:             aws.String(l.Tablename),
+			ExclusiveStartKey:     lastEvaluatedKey,
+		}
+		out, err := l.svc.Scan(scanInput)
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+
+		if len(out.Items) == 0 {
+			break
+		}
+
+		for _, item := range out.Items {
+			var e event
+			if err := dynamodbattribute.UnmarshalMap(item, &e); err != nil {
+				continue
+			}
+			// Only update if the attribute is missing
+			if e.CreatedAtDate != "" {
+				continue
+			}
+			createdAtDate := time.Unix(e.CreatedAt, 0).UTC().Format(iso8601DateFormat)
+			updateInput := &dynamodb.UpdateItemInput{
+				TableName: aws.String(l.Tablename),
+				Key: map[string]*dynamodb.AttributeValue{
+					keySessionID:  item[keySessionID],
+					keyEventIndex: item[keyEventIndex],
+				},
+				UpdateExpression: aws.String("SET #cd = :cd"),
+				ExpressionAttributeNames: map[string]*string{
+					"#cd": aws.String(keyDate),
+				},
+				ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+					":cd": {S: aws.String(createdAtDate)},
+				},
+			}
+			_, err = l.svc.UpdateItem(updateInput)
+			if err != nil {
+				log.Warnf("Failed to update item %s/%d: %v", e.SessionID, e.EventIndex, err)
+			}
+		}
+
+		lastEvaluatedKey = out.LastEvaluatedKey
+		if len(lastEvaluatedKey) == 0 {
+			break
+		}
+	}
+	return nil
+}
