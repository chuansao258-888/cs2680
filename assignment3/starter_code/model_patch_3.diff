+// updateTable brings an existing table up to date with the current schema:
+// adds the time search index (V2) if it is missing and migrates the events
+// stored before the index was created, so that they contain the normalized
+// date attribute the index is keyed on.
+func (l *Log) updateTable(ctx context.Context, tableName string) error {
+	exists, err := l.indexExists(tableName, indexTimeSearchV2)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if exists {
+		return nil
+	}
+
+	provisionedThroughput := dynamodb.ProvisionedThroughput{
+		ReadCapacityUnits:  aws.Int64(l.ReadCapacityUnits),
+		WriteCapacityUnits: aws.Int64(l.WriteCapacityUnits),
+	}
+	_, err = l.svc.UpdateTableWithContext(ctx, &dynamodb.UpdateTableInput{
+		TableName: aws.String(tableName),
+		GlobalSecondaryIndexUpdates: []*dynamodb.GlobalSecondaryIndexUpdate{
+			{
+				Create: &dynamodb.CreateGlobalSecondaryIndexAction{
+					IndexName: aws.String(indexTimeSearchV2),
+					KeySchema: []*dynamodb.KeySchemaElement{
+						{
+							AttributeName: aws.String(keyDate),
+							KeyType:       aws.String("HASH"),
+						},
+						{
+							AttributeName: aws.String(keyCreatedAt),
+							KeyType:       aws.String("RANGE"),
+						},
+					},
+					Projection: &dynamodb.Projection{
+						ProjectionType: aws.String("ALL"),
+					},
+					ProvisionedThroughput: &provisionedThroughput,
+				},
+			},
+		},
+	})
+	if err != nil {
+		return trace.Wrap(convertError(err))
+	}
+
+	log.Infof("Waiting until index %q on table %q is created", indexTimeSearchV2, tableName)
+	// There is no waiter for the index creation, but the index is a part of
+	// the table, so the table goes back to ACTIVE state when the index is
+	// ready to be used.
+	err = l.svc.WaitUntilTableExistsWithContext(ctx, &dynamodb.DescribeTableInput{
+		TableName: aws.String(tableName),
+	})
+	if err != nil {
+		return trace.Wrap(convertError(err))
+	}
+	log.Infof("Index %q on table %q has been created", indexTimeSearchV2, tableName)
+
+	// Events stored before the index was created do not have the date
+	// attribute set, so they are invisible to the index and have to be
+	// migrated.
+	return trace.Wrap(l.migrateDateAttribute(ctx))
+}
