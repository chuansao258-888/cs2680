+// daysBetween returns the inclusive list of ISO 8601 ("yyyy-mm-dd") dates
+// between the given from and to values, in ascending order. The dates are
+// normalized to UTC and every day of the range is returned exactly once,
+// including the days the range starts and ends on.
+func daysBetween(from, to time.Time) []string {
+	var days []string
+	fromUTC := from.UTC()
+	toUTC := to.UTC()
+	if toUTC.Before(fromUTC) {
+		return days
+	}
+
+	day := time.Date(fromUTC.Year(), fromUTC.Month(), fromUTC.Day(), 0, 0, 0, 0, time.UTC)
+	lastDay := time.Date(toUTC.Year(), toUTC.Month(), toUTC.Day(), 0, 0, 0, 0, time.UTC)
+	for !day.After(lastDay) {
+		days = append(days, day.Format(iso8601DateFormat))
+		day = day.AddDate(0, 0, 1)
+	}
+	return days
+}
