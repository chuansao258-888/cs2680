+// daysBetween returns the list of all dates (in ISO 8601 format) inclusively
+// between two timestamps. The returned dates are normalized to UTC and
+// cover the month and year boundaries.
+func daysBetween(t1 time.Time, t2 time.Time) []string {
+	var days []string
+	t1, t2 = t1.UTC(), t2.UTC()
+	if t2.Before(t1) {
+		return days
+	}
+	// Normalize both ends to the beginning of the day, so that the range
+	// always includes the full days of the first and the last timestamp.
+	current := time.Date(t1.Year(), t1.Month(), t1.Day(), 0, 0, 0, 0, time.UTC)
+	end := time.Date(t2.Year(), t2.Month(), t2.Day(), 0, 0, 0, 0, time.UTC)
+	for ; !current.After(end); current = current.AddDate(0, 0, 1) {
+		days = append(days, current.Format(iso8601DateFormat))
+	}
+	return days
+}
