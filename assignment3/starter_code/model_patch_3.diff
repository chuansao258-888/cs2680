+// migrateDateAttribute is a one-time migration process which walks through
+// all items in the events table and sets the normalized date attribute
+// (keyDate) on every event, derived from the time the event was created at.
+// The migration is executed in-place: every item is updated with a single
+// UpdateItem call keyed on the primary key of the item (SessionID and
+// EventIndex), so it honors the cancellation of the passed in context.
+func (l *Log) migrateDateAttribute(ctx context.Context) error {
+	var lastEvaluatedKey map[string]*dynamodb.AttributeValue
+	for {
+		select {
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		default:
+		}
+		out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+			TableName:         aws.String(l.Tablename),
+			ExclusiveStartKey: lastEvaluatedKey,
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		for _, item := range out.Items {
+			var e event
+			if err := dynamodbattribute.UnmarshalMap(item, &e); err != nil {
+				return trace.Wrap(err)
+			}
+			date := time.Unix(e.CreatedAt, 0).UTC().Format(iso8601DateFormat)
+			_, err := l.svc.UpdateItemWithContext(ctx, &dynamodb.UpdateItemInput{
+				Key: map[string]*dynamodb.AttributeValue{
+					keySessionID:  item[keySessionID],
+					keyEventIndex: item[keyEventIndex],
+				},
+				TableName:        aws.String(l.Tablename),
+				UpdateExpression: aws.String("SET #createdAtDate = :createdAtDate"),
+				ExpressionAttributeNames: map[string]*string{
+					"#createdAtDate": aws.String(keyDate),
+				},
+				ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+					":createdAtDate": {
+						S: aws.String(date),
+					},
+				},
+			})
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+		}
+		lastEvaluatedKey = out.LastEvaluatedKey
+		if len(lastEvaluatedKey) == 0 {
+			return nil
+		}
+	}
+}
