+++ b/scanner/redhatbase_kernel_test.go
@@ -0,0 +1,103 @@
+package scanner
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/constant"
+	"github.com/future-architect/vuls/models"
+)
+
+func Test_redhatBase_parseInstalledPackagesWithDebugKernel(t *testing.T) {
+	tests := []struct {
+		name     string
+		distro   config.Distro
+		kernel   models.Kernel
+		in       string
+		expected models.Packages
+	}{
+		{
+			name:   "running debug kernel only keeps the debug kernel packages",
+			distro: config.Distro{Family: constant.Alma, Release: "9.4"},
+			kernel: models.Kernel{Release: "5.14.0-427.13.1.el9_4.x86_64+debug"},
+			in: `kernel 0 5.14.0 427.13.1.el9_4 x86_64 (none)
+kernel 0 5.14.0 427.18.1.el9_4 x86_64 (none)
+kernel-core 0 5.14.0 427.13.1.el9_4 x86_64 (none)
+kernel-core 0 5.14.0 427.18.1.el9_4 x86_64 (none)
+kernel-debug 0 5.14.0 427.13.1.el9_4 x86_64 (none)
+kernel-debug 0 5.14.0 427.18.1.el9_4 x86_64 (none)
+kernel-debug-core 0 5.14.0 427.13.1.el9_4 x86_64 (none)
+kernel-debug-modules 0 5.14.0 427.13.1.el9_4 x86_64 (none)
+kernel-debug-modules-extra 0 5.14.0 427.13.1.el9_4 x86_64 (none)
+kernel-modules 0 5.14.0 427.13.1.el9_4 x86_64 (none)
+kernel-modules-extra 0 5.14.0 427.13.1.el9_4 x86_64 (none)
+kernel-tools 0 5.14.0 427.18.1.el9_4 x86_64 (none)
+kernel-srpm-macros 0 1.0 98.el9 noarch (none)
+perf 0 5.14.0 427.18.1.el9_4 x86_64 (none)
+python-perf 0 5.14.0 427.18.1.el9_4 x86_64 (none)
+openssl 0 3.0.8 9.el9_4 x86_64 (none)`,
+			expected: models.Packages{
+				"kernel-debug":               {Name: "kernel-debug", Version: "5.14.0", Release: "427.13.1.el9_4", Arch: "x86_64"},
+				"kernel-debug-core":          {Name: "kernel-debug-core", Version: "5.14.0", Release: "427.13.1.el9_4", Arch: "x86_64"},
+				"kernel-debug-modules":       {Name: "kernel-debug-modules", Version: "5.14.0", Release: "427.13.1.el9_4", Arch: "x86_64"},
+				"kernel-debug-modules-extra": {Name: "kernel-debug-modules-extra", Version: "5.14.0", Release: "427.13.1.el9_4", Arch: "x86_64"},
+				"kernel-tools":               {Name: "kernel-tools", Version: "5.14.0", Release: "427.18.1.el9_4", Arch: "x86_64"},
+				"kernel-srpm-macros":         {Name: "kernel-srpm-macros", Version: "1.0", Release: "98.el9", Arch: "noarch"},
+				"perf":                       {Name: "perf", Version: "5.14.0", Release: "427.18.1.el9_4", Arch: "x86_64"},
+				"python-perf":                {Name: "python-perf", Version: "5.14.0", Release: "427.18.1.el9_4", Arch: "x86_64"},
+				"openssl":                    {Name: "openssl", Version: "3.0.8", Release: "9.el9_4", Arch: "x86_64"},
+			},
+		},
+		{
+			name:   "running kernel-uek",
+			distro: config.Distro{Family: constant.Oracle, Release: "8.9"},
+			kernel: models.Kernel{Release: "5.15.0-103.118.14.4.el8uek.x86_64"},
+			in: `kernel-uek 0 5.15.0 103.118.14.4.el8uek x86_64 (none)
+kernel-uek 0 5.15.0 104.118.15.4.el8uek x86_64 (none)
+kernel-uek-core 0 5.15.0 103.118.14.4.el8uek x86_64 (none)
+kernel-uek-devel 0 5.15.0 103.118.14.4.el8uek x86_64 (none)
+kernel 0 5.15.0 104.el9 x86_64 (none)
+kernel-livepatch-tools 0 1.0.0 1.el8 x86_64 (none)`,
+			expected: models.Packages{
+				"kernel-uek":             {Name: "kernel-uek", Version: "5.15.0", Release: "103.118.14.4.el8uek", Arch: "x86_64"},
+				"kernel-uek-core":        {Name: "kernel-uek-core", Version: "5.15.0", Release: "103.118.14.4.el8uek", Arch: "x86_64"},
+				"kernel-uek-devel":       {Name: "kernel-uek-devel", Version: "5.15.0", Release: "103.118.14.4.el8uek", Arch: "x86_64"},
+				"kernel-livepatch-tools": {Name: "kernel-livepatch-tools", Version: "1.0.0", Release: "1.el8", Arch: "x86_64"},
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := newRHEL(config.ServerInfo{})
+			r.Distro = tt.distro
+			r.Kernel = tt.kernel
+
+			packages, _, err := r.parseInstalledPackages(tt.in)
+			if err != nil {
+				t.Fatalf("Unexpected error: %s", err)
+			}
+			for name, expected := range tt.expected {
+				pack, ok := packages[name]
+				if !ok {
+					t.Errorf("%s: not found in the scan result", name)
+					continue
+				}
+				if pack.Version != expected.Version {
+					t.Errorf("%s version: expected %s, actual %s", name, expected.Version, pack.Version)
+				}
+				if pack.Release != expected.Release {
+					t.Errorf("%s release: expected %s, actual %s", name, expected.Release, pack.Release)
+				}
+				if pack.Arch != expected.Arch {
+					t.Errorf("%s arch: expected %s, actual %s", name, expected.Arch, pack.Arch)
+				}
+			}
+			for name := range packages {
+				if _, ok := tt.expected[name]; !ok {
+					t.Errorf("unexpected package in the scan result: %s", name)
+				}
+			}
+		})
+	}
+}
