-func isRunningKernel(pack models.Package, family string, kernel models.Kernel) (isKernel, running bool) {
+// isKernelPackage reports whether the package name belongs to the kernel
+// image/modules/devel package families, including the debug and realtime variants.
+// kernel-adjacent accessory packages (kernel-tools, kernel-srpm-macros, perf, ...)
+// and kernel-livepatch-* are not kernel packages.
+func isKernelPackage(name string) bool {
+	switch {
+	case name == "kernel",
+		name == "kernel-core",
+		name == "kernel-devel",
+		strings.HasPrefix(name, "kernel-modules"),
+		strings.HasPrefix(name, "kernel-debug"),
+		strings.HasPrefix(name, "kernel-rt"),
+		strings.HasPrefix(name, "kernel-uek"):
+		return true
+	}
+	return false
+}
+
+// isDebugKernelPackage reports whether the kernel package is a debug variant
+func isDebugKernelPackage(name string) bool {
+	return strings.Contains(name, "debug")
+}
+
+// distroMajorVersion returns the major version of the distribution release.
+func distroMajorVersion(release string) (int, bool) {
+	release = strings.TrimPrefix(release, "stream")
+	if release == "" {
+		return 0, false
+	}
+	major, err := strconv.Atoi(strings.Split(release, ".")[0])
+	if err != nil {
+		return 0, false
+	}
+	return major, true
+}
+
+// useArchInKernelRelease reports whether the running kernel release string
+// (from uname) includes the architecture, e.g. 4.18.0-513.24.1.el8_9.x86_64
+func useArchInKernelRelease(family, release string) bool {
+	switch family {
+	case constant.Alma, constant.Rocky, constant.Amazon:
+		return true
+	case constant.Fedora:
+		if major, ok := distroMajorVersion(release); ok {
+			return 9 <= major
+		}
+	case constant.RedHat, constant.CentOS, constant.Oracle:
+		if major, ok := distroMajorVersion(release); ok {
+			return 6 <= major
+		}
+	}
+	return true
+}
+
+// isRunningKernel detects whether the package is a kernel package and whether
+// it corresponds to the running kernel. release is the distribution release
+// (e.g. 8.9, 2 (Karoo)) and is used to decide the kernel release string format.
+func isRunningKernel(pack models.Package, family string, release string, kernel models.Kernel) (isKernel, running bool) {
 	switch family {
 	case constant.OpenSUSE, constant.OpenSUSELeap, constant.SUSEEnterpriseServer, constant.SUSEEnterpriseDesktop:
 		if pack.Name == "kernel-default" {
@@ -27,12 +85,22 @@ func isRunningKernel(pack models.Package, family string, kernel models.Kernel) (
 		return false, false
 
 	case constant.RedHat, constant.Oracle, constant.CentOS, constant.Alma, constant.Rocky, constant.Amazon, constant.Fedora:
-		switch pack.Name {
-		case "kernel", "kernel-devel", "kernel-core", "kernel-modules", "kernel-uek":
-			ver := fmt.Sprintf("%s-%s.%s", pack.Version, pack.Release, pack.Arch)
-			return true, kernel.Release == ver
+		if !isKernelPackage(pack.Name) {
+			return false, false
 		}
-		return false, false
+
+		// A debug kernel is only running the debug kernel packages and
+		// a non-debug kernel is only running the non-debug kernel packages.
+		ver := fmt.Sprintf("%s-%s", pack.Version, pack.Release)
+		if useArchInKernelRelease(family, release) {
+			ver = fmt.Sprintf("%s.%s", ver, pack.Arch)
+			if isDebugKernelPackage(pack.Name) {
+				ver += "+debug"
+			}
+		} else if isDebugKernelPackage(pack.Name) {
+			ver += "debug"
+		}
+		return true, kernel.Release == ver
 
 	default:
 		logging.Log.Warnf("Reboot required is not implemented yet: %s, %v", family, kernel)
