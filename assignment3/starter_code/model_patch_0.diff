+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """
+        Builds a regex to use for matching ILIKE queries, e.g. pattern ``Sm*h``
+        matches ``Smith`` and ``smash``, but not ``sarah``.
+
+        Mirrors the semantics of the infobase ``~`` operator, which translates
+        to a case insensitive SQL ``LIKE``: the match is anchored on both ends of
+        the text, ``*`` stands for any (possibly empty) run of characters and
+        ``_`` is not a wildcard, i.e. it is matched literally.
+
+        :param str pattern: ILIKE style pattern, e.g. "John*"
+        :param str text: Text to match the pattern against
+        :rtype: bool
+        :return: Whether text matches pattern, ignoring case
+        """
+        # Escape everything (including ``_``) so that only ``*`` remains special,
+        # then turn ``*`` into a multi character wildcard.
+        regex = "^" + re.escape(pattern).replace("\\*", ".*") + "$"
+        return re.match(regex, text, re.IGNORECASE) is not None
+
