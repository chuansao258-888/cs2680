+    @staticmethod
+    def regex_ilike(pattern: str, text: str) -> bool:
+        """
+        Return True if `text` matches the `pattern`, mimicking the ILIKE
+        queries that infogami runs in production.
+
+        The match is case-insensitive and covers the whole string, `*` is a
+        wildcard for any sequence of characters, and `_` has no special
+        meaning, e.g.::
+
+            >>> MockSite.regex_ilike('john*', 'John Smith')
+            True
+            >>> MockSite.regex_ilike('John Smith', 'john smith')
+            True
+            >>> MockSite.regex_ilike('*doyle*', 'Arthur Conan Doyle')
+            True
+            >>> MockSite.regex_ilike('san_francisco', 'san francisco')
+            False
+
+        :param str pattern: ILIKE pattern, e.g. "Jane*"
+        :param str text: Value to match against the pattern
+        :rtype: bool
+        """
+        regex = '.*'.join(re.escape(part) for part in pattern.split('*'))
+        return bool(re.fullmatch(regex, text, flags=re.IGNORECASE))
+
