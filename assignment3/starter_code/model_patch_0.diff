+    @staticmethod
+    def regex_ilike(pattern: str, text: str) -> bool:
+        """
+        Constructs a regex pattern for ILIKE operation and matches it against
+        the text. Supports flexible, case-insensitive matching with:
+        - Case-insensitive full-string matching
+        - * treated as multi-character wildcard
+        - _ ignored (treated as regular character, not single-char wildcard)
+
+        :param str pattern: ILIKE pattern string
+        :param str text: Text to match against
+        :rtype: bool
+        :return: True if text matches pattern
+        """
+        # Escape regex special characters except *
+        escaped = []
+        for ch in pattern:
+            if ch == '*':
+                escaped.append('.*')
+            elif ch in r'\.^$+?{}[]|()':
+                escaped.append(re.escape(ch))
+            else:
+                escaped.append(ch)
+        regex_str = '^' + ''.join(escaped) + '$'
+        return bool(re.match(regex_str, text, re.IGNORECASE))
+
