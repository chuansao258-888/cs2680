+/**
+ * Removes client information entries for devices that are no longer in the provided valid device IDs.
+ * If the valid device IDs list is empty, no deletion occurs.
+ *
+ * @param validDeviceIds - List of valid device IDs.
+ * @param matrixClient - Matrix client instance used to delete account data.
+ */
+export const pruneClientInformation = async (validDeviceIds: string[], matrixClient: MatrixClient): Promise<void> => {
+    if (validDeviceIds.length === 0) return;
+
+    const accountData = matrixClient.getAccountData();
+    for (const eventType of accountData.keys()) {
+        if (eventType.startsWith("io.element.matrix_client_information.")) {
+            const deviceId = eventType.slice("io.element.matrix_client_information.".length);
+            if (!validDeviceIds.includes(deviceId)) {
+                await matrixClient.deleteAccountData(eventType);
+            }
+        }
+    }
 };
