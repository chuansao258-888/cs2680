 func init() {
-	// exporter registers itself on the prom client DefaultRegistrar
-	exporter, err := prometheus.New()
+	// the exporter, and therefore the meter provider consuming it, is built
+	// lazily through GetExporter driven by configuration.
+	// constructing a prometheus exporter here would register collectors on the
+	// prometheus default registrar, which makes building a configured exporter
+	// later fail with duplicate registration errors.
+	//
+	// until a real provider is registered at startup, the global meter provider
+	// behaves as a no-op. the Meter below is a late-bound placeholder: any
+	// instruments built from it before the provider is swapped in are re-bound
+	// when otel.SetMeterProvider is called.
+	Meter = otel.Meter("github.com/flipt-io/flipt")
+}
+
+// GetExporter builds the metrics exporter from the supplied configuration and
+// returns the SDK reader consuming it, along with a function for shutting the
+// exporter down.
+// The exporter is constructed at most once per process, which is why the
+// underlying sync.Once is package scoped.
+func GetExporter(ctx context.Context, cfg *config.MetricsConfig) (sdkmetric.Reader, func(context.Context) error, error) {
+	var (
+		reader   sdkmetric.Reader
+		shutdown func(context.Context) error
+		err      error
+	)
+
+	metricExpOnce.Do(func() {
+		switch cfg.Exporter {
+		case config.MetricsPrometheus:
+			// exporter registers itself on the prom client DefaultRegistrar
+			exp, expErr := prometheus.New()
+			if expErr != nil {
+				err = fmt.Errorf("creating prometheus exporter: %w", expErr)
+				return
+			}
+
+			reader = exp
+			shutdown = func(context.Context) error { return nil }
+		case config.MetricsOTLP:
+			reader, shutdown, err = otlpExporter(ctx, cfg)
+		default:
+			err = fmt.Errorf("unsupported metrics exporter: %s", cfg.Exporter)
+		}
+	})
+
+	return reader, shutdown, err
+}
+
+// otlpExporter constructs an OTLP metric reader from the supplied metrics
+// configuration. The endpoint may be expressed with a scheme (http, https or
+// grpc) or as a bare host:port, in which case grpc is assumed.
+func otlpExporter(ctx context.Context, cfg *config.MetricsConfig) (sdkmetric.Reader, func(context.Context) error, error) {
+	u, err := url.Parse(cfg.OTLP.Endpoint)
 	if err != nil {
-		log.Fatal(err)
+		return nil, nil, fmt.Errorf("parsing otlp endpoint: %w", err)
 	}
 
-	provider := sdkmetric.NewMeterProvider(sdkmetric.WithReader(exporter))
-	otel.SetMeterProvider(provider)
+	var (
+		reader sdkmetric.Reader
+
+		shutdown = func(context.Context) error { return nil }
+	)
+
+	switch u.Scheme {
+	case "http", "https":
+		opts := []otlpmetrichttp.Option{
+			otlpmetrichttp.WithEndpoint(u.Host),
+			otlpmetrichttp.WithHeaders(cfg.OTLP.Headers),
+		}
+
+		if u.Path != "" {
+			opts = append(opts, otlpmetrichttp.WithURLPath(u.Path))
+		}
+
+		if u.Scheme == "http" {
+			opts = append(opts, otlpmetrichttp.WithInsecure())
+		}
+
+		exp, err := otlpmetrichttp.New(ctx, opts...)
+		if err != nil {
+			return nil, nil, fmt.Errorf("creating otlp http exporter: %w", err)
+		}
+
+		reader, shutdown = sdkmetric.NewPeriodicReader(exp), exp.Shutdown
+	default:
+		// when the endpoint has no scheme, or is expressed with a grpc scheme,
+		// we assume that it is a grpc host:port pair.
+		endpoint := cfg.OTLP.Endpoint
+		if u.Host != "" {
+			endpoint = u.Host
+		}
+
+		exp, err := otlpmetricgrpc.New(ctx,
+			otlpmetricgrpc.WithEndpoint(endpoint),
+			otlpmetricgrpc.WithHeaders(cfg.OTLP.Headers),
+			// TODO: support TLS
+			otlpmetricgrpc.WithInsecure(),
+		)
+		if err != nil {
+			return nil, nil, fmt.Errorf("creating otlp grpc exporter: %w", err)
+		}
+
+		reader, shutdown = sdkmetric.NewPeriodicReader(exp), exp.Shutdown
+	}
 
-	Meter = provider.Meter("github.com/flipt-io/flipt")
+	return reader, shutdown, nil
