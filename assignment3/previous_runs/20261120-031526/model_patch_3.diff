+// indexExists returns true if the global secondary index with the given name
+// exists on the table with the given name. It describes the table and looks
+// for the index in the list of its global secondary indexes.
+func (l *Log) indexExists(tableName string, indexName string) (bool, error) {
+	out, err := l.svc.DescribeTable(&dynamodb.DescribeTableInput{
+		TableName: aws.String(tableName),
+	})
+	if err != nil {
+		return false, trace.Wrap(convertError(err))
+	}
+	if out.Table == nil {
+		return false, nil
+	}
+	for _, index := range out.Table.GlobalSecondaryIndexes {
+		if matchesIndexName(aws.StringValue(index.IndexName), indexName) {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// matchesIndexName compares the index names ignoring the optional "index"
+// prefix, so that both the index constant name (indexTimeSearchV2) and the
+// name it is stored under in DynamoDB (timesearchV2) match each other.
+func matchesIndexName(indexName, expected string) bool {
+	if strings.EqualFold(indexName, expected) {
+		return true
+	}
+	const prefix = "index"
+	trimmedIndex := strings.TrimPrefix(strings.ToLower(indexName), prefix)
+	trimmedExpected := strings.TrimPrefix(strings.ToLower(expected), prefix)
+	if trimmedIndex != "" && trimmedExpected != "" {
+		return trimmedIndex == trimmedExpected
+	}
+	return false
+}
+
+// migrateTimeSearchV2 brings an existing table up to date: if the table
+// does not have the indexTimeSearchV2 global secondary index yet, all
+// already stored events are migrated to carry the CreatedAtDate attribute
+// and the index is created afterwards, so that it is built on top of the
+// backfilled data.
+func (l *Log) migrateTimeSearchV2(ctx context.Context) error {
+	exists, err := l.indexExists(l.Tablename, indexTimeSearchV2)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if exists {
+		return nil
+	}
+
+	// Fill in the date attribute of all previously stored events first.
+	// Items updated while the index is being created are picked up by the
+	// index build, so the backfill must happen before the index request.
+	if err := l.migrateDateAttribute(ctx); err != nil {
+		return trace.Wrap(err)
+	}
+
+	provisionedThroughput := dynamodb.ProvisionedThroughput{
+		ReadCapacityUnits:  aws.Int64(l.ReadCapacityUnits),
+		WriteCapacityUnits: aws.Int64(l.WriteCapacityUnits),
+	}
+	_, err = l.svc.UpdateTableWithContext(ctx, &dynamodb.UpdateTableInput{
+		TableName: aws.String(l.Tablename),
+		GlobalSecondaryIndexUpdates: []*dynamodb.GlobalSecondaryIndexUpdate{
+			{
+				Create: &dynamodb.CreateGlobalSecondaryIndexAction{
+					IndexName: aws.String(indexTimeSearchV2),
+					KeySchema: []*dynamodb.KeySchemaElement{
+						{
+							AttributeName: aws.String(keyDate),
+							KeyType:       aws.String("HASH"),
+						},
+						{
+							AttributeName: aws.String(keyCreatedAt),
+							KeyType:       aws.String("RANGE"),
+						},
+					},
+					Projection: &dynamodb.Projection{
+						ProjectionType: aws.String(dynamodb.ProjectionTypeAll),
+					},
+					ProvisionedThroughput: &provisionedThroughput,
+				},
+			},
+		},
+	})
+	if err != nil {
+		return trace.Wrap(convertError(err))
+	}
+	return nil
+}
+
+// migrateDateAttribute performs a full scan of the events table and updates
+// every item to carry the normalized creation date (CreatedAtDate) derived
+// from the item's creation time (CreatedAt). It is a synchronous one-time
+// migration used to bring events stored before the date attribute was
+// introduced up to date. The migration honors the cancellation of the
+// passed context.
+func (l *Log) migrateDateAttribute(ctx context.Context) error {
+	var lastEvaluatedKey map[string]*dynamodb.AttributeValue
+	for {
+		select {
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		default:
+		}
+
+		out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+			TableName:         aws.String(l.Tablename),
+			ExclusiveStartKey: lastEvaluatedKey,
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+
+		for _, item := range out.Items {
+			select {
+			case <-ctx.Done():
+				return trace.Wrap(ctx.Err())
+			default:
+			}
+			if err := l.migrateItemDateAttribute(ctx, item); err != nil {
+				return trace.Wrap(err)
+			}
+		}
+
+		if len(out.LastEvaluatedKey) == 0 {
+			break
+		}
+		lastEvaluatedKey = out.LastEvaluatedKey
+	}
+	return nil
+}
+
+// migrateItemDateAttribute updates a single scanned item with the ISO 8601
+// date derived from its creation time. Items that already carry a non-empty
+// date attribute, or that can not be keyed/derived, are left untouched.
+func (l *Log) migrateItemDateAttribute(ctx context.Context, item map[string]*dynamodb.AttributeValue) error {
+	if date := item[keyDate]; date != nil && aws.StringValue(date.S) != "" {
+		return nil
+	}
+
+	// The item must be addressable by the primary key of the table.
+	sessionID, eventIndex := item[keySessionID], item[keyEventIndex]
+	if sessionID == nil || eventIndex == nil {
+		return nil
+	}
+
+	// Derive the date out of the creation time of the event.
+	createdAt := item[keyCreatedAt]
+	if createdAt == nil {
+		return nil
+	}
+	seconds, err := strconv.ParseFloat(aws.StringValue(createdAt.N), 64)
+	if err != nil {
+		log.Warnf("Unable to parse creation time %q of event: %v", aws.StringValue(createdAt.N), err)
+		return nil
+	}
+	date := formatEventDate(time.Unix(int64(seconds), 0).UTC())
+
+	_, err = l.svc.UpdateItemWithContext(ctx, &dynamodb.UpdateItemInput{
+		TableName: aws.String(l.Tablename),
+		Key: map[string]*dynamodb.AttributeValue{
+			keySessionID:  sessionID,
+			keyEventIndex: eventIndex,
+		},
+		UpdateExpression: aws.String("SET " + keyDate + " = :date"),
+		ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+			":date": {S: aws.String(date)},
+		},
+	})
+	if err != nil {
+		return trace.Wrap(convertError(err))
+	}
+	return nil
+}
