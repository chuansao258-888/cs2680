+// formatEventDate returns the normalized date of the event creation time,
+// the value stored in the keyDate attribute and used to search events by day.
+func formatEventDate(createdAt time.Time) string {
+	return createdAt.UTC().Format(iso8601DateFormat)
+}
+
+// daysBetween returns the inclusive list of ISO 8601 ("yyyy-mm-dd") dates
+// between the two given timestamps, in ascending order - every day from the
+// day of fromDate through the day of toDate, including the ranges that span
+// month boundaries. The returned list always contains at least one date, in
+// case both timestamps fall within the same day.
+//
+// Both arguments are accepted either as time.Time values or as strings
+// holding a date in the iso8601DateFormat format.
+func daysBetween(fromDate, toDate interface{}) []string {
+	from, err := parseDate(fromDate)
+	if err != nil {
+		return nil
+	}
+	to, err := parseDate(toDate)
+	if err != nil {
+		return nil
+	}
+
+	var dates []string
+	for current := from; !current.After(to); current = current.AddDate(0, 0, 1) {
+		dates = append(dates, current.Format(iso8601DateFormat))
+	}
+
+	return dates
+}
+
+// parseDate converts the supported date representations - a timestamp or an
+// ISO 8601 ("yyyy-mm-dd") date string - to a timestamp at the beginning of
+// the day in UTC, so that only the day part of the value matters.
+func parseDate(value interface{}) (time.Time, error) {
+	switch val := value.(type) {
+	case time.Time:
+		utc := val.UTC()
+		return time.Date(utc.Year(), utc.Month(), utc.Day(), 0, 0, 0, 0, time.UTC), nil
+	case *time.Time:
+		if val == nil {
+			return time.Time{}, trace.BadParameter("nil date")
+		}
+		return parseDate(*val)
+	case string:
+		parsed, err := time.Parse(iso8601DateFormat, val)
+		if err != nil {
+			return time.Time{}, trace.BadParameter("invalid date %q: %v", val, err)
+		}
+		return parsed.UTC(), nil
+	}
+	return time.Time{}, trace.BadParameter("unsupported date type %T", value)
+}
