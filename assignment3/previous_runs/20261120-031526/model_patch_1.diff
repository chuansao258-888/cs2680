@@ -1,11 +1,18 @@
 package metrics
 
 import (
-	"log"
+	"context"
+	"fmt"
+	"net/url"
+	"sync"
 
+	"go.flipt.io/flipt/internal/config"
 	"go.opentelemetry.io/otel"
+	"go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetricgrpc"
+	"go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetrichttp"
 	"go.opentelemetry.io/otel/exporters/prometheus"
 	"go.opentelemetry.io/otel/metric"
+	noopmetric "go.opentelemetry.io/otel/metric/noop"
 	sdkmetric "go.opentelemetry.io/otel/sdk/metric"
 )
 
@@ -13,18 +20,90 @@ import (
 var Meter metric.Meter
 
 func init() {
-	// exporter registers itself on the prom client DefaultRegistrar
-	exporter, err := prometheus.New()
-	if err != nil {
-		log.Fatal(err)
-	}
-
-	provider := sdkmetric.NewMeterProvider(sdkmetric.WithReader(exporter))
+	// default to a no-op meter provider; the configured exporter is built
+	// lazily via GetExporter so it can be driven from configuration.
+	// Building the Prometheus exporter here would register its collectors
+	// on the prometheus DefaultRegistrar and cause duplicate registration
+	// errors when GetExporter later builds the configured exporter.
+	provider := noopmetric.NewMeterProvider()
 	otel.SetMeterProvider(provider)
 
 	Meter = provider.Meter("github.com/flipt-io/flipt")
 }
 
+var (
+	metricExpOnce sync.Once
+	metricExp     sdkmetric.Reader
+	metricExpFunc func(context.Context) error = func(context.Context) error { return nil }
+	metricExpErr  error
+)
+
+// GetExporter retrieves a configured sdkmetric.Reader based on the provided
+// configuration. Supports Prometheus and OTLP.
+func GetExporter(ctx context.Context, cfg *config.MetricsConfig) (sdkmetric.Reader, func(context.Context) error, error) {
+	metricExpOnce.Do(func() {
+		metricExp, metricExpErr = nil, nil
+		metricExpFunc = func(context.Context) error { return nil }
+
+		switch cfg.Exporter {
+		case config.MetricsPrometheus:
+			// exporter registers itself on the prom client DefaultRegistrar
+			exporter, err := prometheus.New()
+			if err != nil {
+				metricExpErr = err
+				return
+			}
+
+			metricExp = exporter
+			metricExpFunc = exporter.Shutdown
+		case config.MetricsOTLP:
+			u, err := url.Parse(cfg.OTLP.Endpoint)
+			if err != nil {
+				metricExpErr = fmt.Errorf("parsing otlp endpoint: %w", err)
+				return
+			}
+
+			var exporter sdkmetric.Exporter
+			switch u.Scheme {
+			case "http", "https":
+				// TODO: support additional configuration options
+				exporter, err = otlpmetrichttp.New(ctx,
+					otlpmetrichttp.WithEndpoint(u.Host+u.Path),
+					otlpmetrichttp.WithHeaders(cfg.OTLP.Headers),
+				)
+			case "grpc":
+				exporter, err = otlpmetricgrpc.New(ctx,
+					otlpmetricgrpc.WithEndpoint(u.Host+u.Path),
+					otlpmetricgrpc.WithHeaders(cfg.OTLP.Headers),
+					// TODO: support TLS
+					otlpmetricgrpc.WithInsecure(),
+				)
+			default:
+				// because of url parsing ambiguity, we'll assume that the endpoint is a host:port with no scheme
+				exporter, err = otlpmetricgrpc.New(ctx,
+					otlpmetricgrpc.WithEndpoint(cfg.OTLP.Endpoint),
+					otlpmetricgrpc.WithHeaders(cfg.OTLP.Headers),
+					// TODO: support TLS
+					otlpmetricgrpc.WithInsecure(),
+				)
+			}
+
+			if err != nil {
+				metricExpErr = err
+				return
+			}
+
+			metricExp = sdkmetric.NewPeriodicReader(exporter)
+			metricExpFunc = metricExp.Shutdown
+		default:
+			metricExpErr = fmt.Errorf("unsupported metrics exporter: %s", cfg.Exporter)
+			return
+		}
+	})
+
+	return metricExp, metricExpFunc, metricExpErr
+}
+
 // MustInt64 returns an instrument provider based on the global Meter.
 // The returns provider panics instead of returning an error when it cannot build
 // a required counter, upDownCounter or histogram.
