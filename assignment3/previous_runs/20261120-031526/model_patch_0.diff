+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """Construct a regex pattern for the given ILIKE query pattern and match
+        it against the given text.
+
+        Matching is case-insensitive and performed against the full string, with
+        `*` acting as a multi-character wildcard. The `_` character is ignored
+        (not treated as a single-character wildcard).
+
+        >>> MockSite.regex_ilike(None, pattern='Foo*', text='Foo Bar')
+        True
+
+        >>> MockSite.regex_ilike(None, pattern='foo bar', text='FOO BAR')
+        True
+
+        :param str pattern: Query pattern, e.g. 'John*'
+        :param str text: Text to match against the pattern
+        :return: Whether the text matches the pattern (ignoring case)
+        """
+        # Escape the pattern so regex metacharacters (other than the ILIKE
+        # wildcard `*`) are treated literally, then translate the wildcards.
+        regex_pattern = re.escape(pattern).replace(r"\*", ".*").replace("_", "")
+        return bool(re.fullmatch(regex_pattern, text, re.IGNORECASE))
