+        a
+        for a in query_authors({'alternate_names~': name})
+        if exact_dates_match(author, a)
+    ]:
+        return candidates
+
+    # 3. Match on surname, with birth and death dates.
+    surname = get_surname(name)
+    candidates = []
+    for query in ({'name~': f'*{surname}*'}, {'alternate_names~': f'*{surname}*'}):
+        candidates += [
+            a
+            for a in query_authors(query)
+            if exact_dates_match(author, a)
