+def find_author(author: dict) -> list[dict]:
+    """
+    Searches OL for author records matching the given author import record.
+
+    Matching is case-insensitive and is attempted in this order, a step only
+    being taken if the previous one found nothing:
+
+    1. the author's name, with the birth and death dates,
+    2. the author's alternate names, with the birth and death dates,
+    3. the author's surname, with the birth and death dates.
+
+    Names may contain the '*' wildcard. When either the birth or the death date
+    is missing from author only case-insensitive name matching is attempted.
+
+    :param author: Author import dict or name string
+                   {"name": "Some One", "birth_date": "1900", "death_date": "1980"}
+    :rtype: list
+    :return: A list of OL author representations that match author
+    """
+    if isinstance(author, str):
+        author = {'name': author}
+    name = author['name']
+    has_dates = bool(author.get('birth_date')) and bool(author.get('death_date'))
+
+    def name_matches(pattern: str) -> list[dict]:
+        return [
+            a
+            for a in query_authors({'name~': pattern})
+            if dates_are_compatible(author, a)
+        ]
