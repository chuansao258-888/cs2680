+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """
+        Constructs a regex pattern for the ILIKE operation and matches it against
+        the given text, mimicking the behavior of the production database.
+
+        Matching is case-insensitive and must consume the whole text. The ILIKE
+        multi-character wildcard ``*`` is supported, while ``_`` is ignored, i.e.
+        it is not treated as a single-character wildcard.
+
+        :param str pattern: ILIKE pattern, e.g. "Smith*"
+        :param str text: Text to match against the pattern
+        :rtype: bool
+        :return: Whether text matches pattern
+        """
+        # Escape regex special characters, then re-introduce the ILIKE wildcard.
+        regex_pattern = ''.join(
+            '.*' if char == '*' else '' if char == '_' else re.escape(char)
+            for char in pattern
+        )
+        regex = re.compile(f'^{regex_pattern}$', re.IGNORECASE)
+        return bool(regex.match(text))
+
