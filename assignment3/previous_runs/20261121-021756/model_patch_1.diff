+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestLoadMetrics(t *testing.T) {
+	var (
+		path     = filepath.Join(t.TempDir(), "metrics.yml")
+		contents = `
+metrics:
+  enabled: true
+  exporter: otlp
+  otlp:
+    endpoint: localhost:4318
+    headers:
+      hello: world
+`
+	)
+
+	require.NoError(t, os.WriteFile(path, []byte(contents), 0644))
+
+	result, err := Load(path)
+	require.NoError(t, err)
+
+	assert.Equal(t, MetricsConfig{
+		Enabled:  true,
+		Exporter: MetricsOTLP,
+		OTLP: OTLPMetricsConfig{
+			Endpoint: "localhost:4318",
+			Headers: map[string]string{
+				"hello": "world",
+			},
+		},
+	}, result.Config.Metrics)
+}
+
+func TestLoadMetricsDefaults(t *testing.T) {
+	var (
+		path = filepath.Join(t.TempDir(), "empty.yml")
+	)
+
+	require.NoError(t, os.WriteFile(path, []byte("version: \"1.0\""), 0644))
+
+	result, err := Load(path)
+	require.NoError(t, err)
+
+	assert.True(t, result.Config.Metrics.Enabled)
+	assert.Equal(t, MetricsPrometheus, result.Config.Metrics.Exporter)
+}
