 func init() {
-	// exporter registers itself on the prom client DefaultRegistrar
-	exporter, err := prometheus.New()
-	if err != nil {
-		log.Fatal(err)
-	}
+	// The metrics package intentionally avoids creating a Prometheus exporter
+	// (and registering its collectors) during init, which would make
+	// GetExporter fail with duplicate registration errors. The global meter
+	// provider is a no-op until an exporter is constructed via GetExporter
+	// and registered with otel.SetMeterProvider; instruments created through
+	// the global Meter are delegated to the real provider once it is set.
+	Meter = otel.Meter("github.com/flipt-io/flipt")
+}
 
-	provider := sdkmetric.NewMeterProvider(sdkmetric.WithReader(exporter))
-	otel.SetMeterProvider(provider)
+var (
+	metricExp     sdkmetric.Reader
+	metricExpFunc func(context.Context) error = func(context.Context) error { return nil }
+	metricExpErr  error
+)
+
+// GetExporter will return an sdkmetric.Reader (exporter) and a shutdown func
+// based on the provided metrics configuration. The exporter is constructed
+// once per process (guarded by metricExpOnce).
+// Supports Prometheus and OTLP (gRPC/HTTP).
+func GetExporter(ctx context.Context, cfg *config.MetricsConfig) (sdkmetric.Reader, func(context.Context) error, error) {
+	metricExpOnce.Do(func() {
+		reader, shutdown, err := getExporter(ctx, cfg)
+		metricExp, metricExpFunc, metricExpErr = reader, shutdown, err
+	})
+
+	return metricExp, metricExpFunc, metricExpErr
+}
 
-	Meter = provider.Meter("github.com/flipt-io/flipt")
+// getExporter builds the configured metrics exporter (reader) and its
+// shutdown function. It supports Prometheus and OTLP (gRPC/HTTP).
+func getExporter(ctx context.Context, cfg *config.MetricsConfig) (sdkmetric.Reader, func(context.Context) error, error) {
+	switch cfg.Exporter {
+	case config.MetricsPrometheus:
+		// exporter registers itself on the prom client DefaultRegistrar
+		promExporter, err := prometheus.New()
+		if err != nil {
+			return nil, nil, err
+		}
+
+		return promExporter, promExporter.Shutdown, nil
+	case config.MetricsOTLP:
+		u, err := url.Parse(cfg.OTLP.Endpoint)
+		if err != nil {
+			return nil, nil, fmt.Errorf("parsing otlp endpoint: %w", err)
+		}
+
+		var exporter sdkmetric.Exporter
+
+		switch u.Scheme {
+		case "http", "https":
+			opts := []otlpmetrichttp.Option{
+				otlpmetrichttp.WithEndpoint(u.Host),
+				otlpmetrichttp.WithURLPath(u.Path),
+				otlpmetrichttp.WithHeaders(cfg.OTLP.Headers),
+			}
+
+			if u.Scheme == "http" {
+				opts = append(opts, otlpmetrichttp.WithInsecure())
+			}
+
+			exp, err := otlpmetrichttp.New(ctx, opts...)
+			if err != nil {
+				return nil, nil, fmt.Errorf("creating otlp http metrics exporter: %w", err)
+			}
+
+			exporter = exp
+		case "grpc":
+			// TODO: support additional configuration options
+			exp, err := otlpmetricgrpc.New(ctx,
+				otlpmetricgrpc.WithEndpoint(u.Host),
+				otlpmetricgrpc.WithHeaders(cfg.OTLP.Headers),
+				// TODO: support TLS
+				otlpmetricgrpc.WithInsecure(),
+			)
+			if err != nil {
+				return nil, nil, fmt.Errorf("creating otlp grpc metrics exporter: %w", err)
+			}
+
+			exporter = exp
+		default:
+			// because of url parsing ambiguity, we'll assume that the endpoint is a host:port with no scheme
+			exp, err := otlpmetricgrpc.New(ctx,
+				otlpmetricgrpc.WithEndpoint(cfg.OTLP.Endpoint),
+				otlpmetricgrpc.WithHeaders(cfg.OTLP.Headers),
+				// TODO: support TLS
+				otlpmetricgrpc.WithInsecure(),
+			)
+			if err != nil {
+				return nil, nil, fmt.Errorf("creating otlp grpc metrics exporter: %w", err)
+			}
+
+			exporter = exp
+		}
+
+		reader := sdkmetric.NewPeriodicReader(exporter)
+
+		return reader, reader.Shutdown, nil
+	default:
+		return nil, nil, fmt.Errorf("unsupported metrics exporter: %s", cfg.Exporter)
+	}
 }
 
