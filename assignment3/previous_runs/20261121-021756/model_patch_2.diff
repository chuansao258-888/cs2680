+func TestIsKernelPackage(t *testing.T) {
+	tests := []struct {
+		name     string
+		expected bool
+	}{
+		{"kernel", true},
+		{"kernel-core", true},
+		{"kernel-modules", true},
+		{"kernel-modules-extra", true},
+		{"kernel-modules-internal", true},
+		{"kernel-devel", true},
+		{"kernel-debug", true},
+		{"kernel-debug-core", true},
+		{"kernel-debug-modules", true},
+		{"kernel-debug-modules-extra", true},
+		{"kernel-debug-devel", true},
+		{"kernel-rt", true},
+		{"kernel-rt-core", true},
+		{"kernel-rt-debug-modules", true},
+		{"kernel-uek", true},
+		{"kernel-uek-core", true},
+		{"kernel-tools", false},
+		{"kernel-tools-libs", false},
+		{"kernel-srpm-macros", false},
+		{"kernel-headers", false},
+		{"kernel-livepatch-tools", false},
+		{"kernel-livepatch-4_18_0-513_24_1_el8_9_x86_64", false},
+		{"perf", false},
+		{"python-perf", false},
+		{"openssl", false},
+	}
+	for _, tt := range tests {
+		if actual := isKernelPackage(tt.name); actual != tt.expected {
+			t.Errorf("isKernelPackage(%s): expected %t, actual %t", tt.name, tt.expected, actual)
+		}
+	}
+}
