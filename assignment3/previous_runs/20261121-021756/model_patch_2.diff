-func isRunningKernel(pack models.Package, family string, kernel models.Kernel) (isKernel, running bool) {
+// isKernelPackage reports whether the package is a kernel package
+// (kernel image, modules, or devel package including debug, rt, uek variants).
+// kernel-adjacent accessory packages such as kernel-tools, kernel-srpm-macros,
+// perf, python-perf, kernel-livepatch-* are not kernel packages.
+func isKernelPackage(name string) bool {
+	switch name {
+	case "kernel", "kernel-core", "kernel-devel":
+		return true
+	}
+	for _, prefix := range []string{"kernel-modules", "kernel-debug", "kernel-rt", "kernel-uek"} {
+		if strings.HasPrefix(name, prefix) {
+			return true
+		}
+	}
+	return false
+}
+
+// isDebugKernelPackage reports whether the kernel package is a debug variant.
+func isDebugKernelPackage(name string) bool {
+	return strings.Contains(name, "debug")
+}
+
+// isDebugKernelRelease reports whether the running kernel is a debug variant.
+func isDebugKernelRelease(release string) bool {
+	return strings.HasSuffix(release, "debug")
+}
+
+// isLegacyKernelReleaseFormat returns true when the kernel release string
+// reported by uname does not have the architecture suffix.
+// RHEL 6 or later (including AlmaLinux, RockyLinux, Amazon Linux)
+// and Fedora 9 or later use "<version>-<release>.<arch>",
+// the older releases use "<version>-<release>".
+func isLegacyKernelReleaseFormat(family, release string) bool {
+	var threshold int
+	switch family {
+	case constant.RedHat, constant.CentOS, constant.Oracle:
+		threshold = 6
+	case constant.Fedora:
+		threshold = 9
+	default:
+		// AlmaLinux, RockyLinux, Amazon Linux only use the modern format.
+		return false
+	}
+	major, err := config.Distro{Family: family, Release: release}.MajorVersion()
+	if err != nil {
+		return false
+	}
+	return major < threshold
+}
