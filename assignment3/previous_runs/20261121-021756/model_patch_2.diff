+				Release: "427.18.1.el9_4",
+				Arch:    "x86_64",
+			},
+			family:   constant.Alma,
+			release:  "9.4",
+			kernel:   models.Kernel{Release: "5.14.0-427.13.1.el9_4.x86_64+debug"},
+			isKernel: true,
+			expected: false,
+		},
+		{
+			// a non-debug kernel package must not match a running debug kernel
+			pack: models.Package{
+				Name:    "kernel",
+				Version: "5.14.0",
+				Release: "427.13.1.el9_4",
+				Arch:    "x86_64",
+			},
+			family:   constant.Alma,
+			release:  "9.4",
+			kernel:   models.Kernel{Release: "5.14.0-427.13.1.el9_4.x86_64+debug"},
