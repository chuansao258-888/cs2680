+func TestIsRunningKernelDebug(t *testing.T) {
+	var tests = []struct {
+		pack     models.Package
+		family   string
+		release  string
+		kernel   models.Kernel
+		isKernel bool
+		expected bool
+	}{
+		{
+			pack: models.Package{
+				Name:    "kernel-debug",
+				Version: "5.14.0",
+				Release: "427.13.1.el9_4",
+				Arch:    "x86_64",
+			},
+			family:   constant.Alma,
+			release:  "9.4",
+			kernel:   models.Kernel{Release: "5.14.0-427.13.1.el9_4.x86_64+debug"},
+			isKernel: true,
+			expected: true,
+		},
+		{
+			pack: models.Package{
+				Name:    "kernel-debug",
