+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """
+        Construct a regex pattern for an ILIKE operation and match it against
+        the given text.
+
+        Matching is case-insensitive and covers the full text. Within the
+        pattern, '*' is treated as a multi-character wildcard and '_' is
+        ignored.
+
+        :param str pattern: e.g. "John*"
+        :param str text: The text to match against the pattern.
+        :return: True if the text matches the pattern, False otherwise.
+        """
+        # Remove ignored characters, then escape everything except the
+        # multi-character wildcard so that '*' translates to '.*'.
+        pattern = pattern.replace("_", "")
+        regex_pattern = ".*".join(re.escape(part) for part in pattern.split("*"))
+        return bool(re.fullmatch(regex_pattern, text, re.IGNORECASE))
+
