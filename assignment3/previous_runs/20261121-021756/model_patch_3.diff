+// timeSearchV2KeySchema returns the key schema of the date based time search
+// index: it is partitioned by the ISO 8601 date of the event and sorted by
+// the creation time within a day.
+func timeSearchV2KeySchema() []*dynamodb.KeySchemaElement {
+	return []*dynamodb.KeySchemaElement{
+		{
+			AttributeName: aws.String(keyDate),
+			KeyType:       aws.String("HASH"),
+		},
+		{
+			AttributeName: aws.String(keyCreatedAt),
+			KeyType:       aws.String("RANGE"),
+		},
+	}
+}
+
+// indexExists returns whether the given global secondary index is present on
+// the table with the given name.
+func (l *Log) indexExists(tableName string, indexName string) (bool, error) {
+	out, err := l.svc.DescribeTable(&dynamodb.DescribeTableInput{
+		TableName: aws.String(tableName),
+	})
+	if err != nil {
+		return false, trace.Wrap(convertError(err))
+	}
+	for _, index := range out.Table.GlobalSecondaryIndexes {
+		if aws.StringValue(index.IndexName) == indexName {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// updateTableIndexes brings an existing table up to date with the current
+// schema, i.e. creates the global secondary indexes this backend expects that
+// the table is still missing.
+func (l *Log) updateTableIndexes(ctx context.Context, tableName string) error {
+	exists, err := l.indexExists(tableName, indexTimeSearchV2)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if exists {
+		return nil
+	}
+	provisionedThroughput := dynamodb.ProvisionedThroughput{
+		ReadCapacityUnits:  aws.Int64(l.ReadCapacityUnits),
+		WriteCapacityUnits: aws.Int64(l.WriteCapacityUnits),
+	}
+	_, err = l.svc.UpdateTableWithContext(ctx, &dynamodb.UpdateTableInput{
+		TableName: aws.String(tableName),
+		GlobalSecondaryIndexUpdates: []*dynamodb.GlobalSecondaryIndexUpdate{
+			{
+				Create: &dynamodb.CreateGlobalSecondaryIndexAction{
+					IndexName:             aws.String(indexTimeSearchV2),
+					KeySchema:             timeSearchV2KeySchema(),
+					Projection:            &dynamodb.Projection{ProjectionType: aws.String("ALL")},
+					ProvisionedThroughput: &provisionedThroughput,
+				},
+			},
+		},
+	})
+	if err != nil {
+		return trace.Wrap(convertError(err))
+	}
+	l.WithField("index", indexTimeSearchV2).Info("Added global secondary index to the events table.")
+	return nil
+}
+
+// migrateDateAttribute goes over all events stored in the table and adds the
+// keyDate ("CreatedAtDate") attribute to them - the ISO 8601 date ("yyyy-mm-dd")
+// the event was created at, derived from its CreatedAt timestamp. Events
+// stored before this attribute was introduced are not searchable by date, so
+// this migration makes them available to queries on indexTimeSearchV2.
+func (l *Log) migrateDateAttribute(ctx context.Context) error {
+	var lastEvaluatedKey map[string]*dynamodb.AttributeValue
+	for {
+		select {
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		default:
+		}
+		out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+			TableName:         aws.String(l.Tablename),
+			ExclusiveStartKey: lastEvaluatedKey,
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		for _, item := range out.Items {
+			var e event
+			if err := dynamodbattribute.UnmarshalMap(item, &e); err != nil {
+				return trace.Wrap(err)
+			}
+			_, err := l.svc.UpdateItemWithContext(ctx, &dynamodb.UpdateItemInput{
+				TableName: aws.String(l.Tablename),
+				Key: map[string]*dynamodb.AttributeValue{
+					keySessionID:  item[keySessionID],
+					keyEventIndex: item[keyEventIndex],
+				},
+				UpdateExpression: aws.String("SET " + keyDate + " = :date"),
+				ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+					":date": {
+						S: aws.String(time.Unix(e.CreatedAt, 0).UTC().Format(iso8601DateFormat)),
+					},
+				},
+			})
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+		}
+		// AWS returns a `lastEvaluatedKey` in case the response is truncated
+		// and needs to be fetched with multiple requests. The final response
+		// is signaled by not setting this value.
+		lastEvaluatedKey = out.LastEvaluatedKey
+		if len(lastEvaluatedKey) == 0 {
+			return nil
+		}
+	}
+}
