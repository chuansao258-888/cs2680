+// daysBetween returns every day between the given start and end dates, both
+// inclusive. A day is represented as an ISO 8601 date string ("yyyy-mm-dd"),
+// the same format used for the keyDate attribute, so the result can be used
+// to iterate over the days a search request spans - including ranges that
+// cross month boundaries.
+func daysBetween(start time.Time, end time.Time) (days []string) {
+	start = start.UTC().Truncate(hoursPerDay)
+	end = end.UTC().Truncate(hoursPerDay)
+	for !start.After(end) {
+		days = append(days, start.Format(iso8601DateFormat))
+		start = start.Add(hoursPerDay)
+	}
+	return days
+}
