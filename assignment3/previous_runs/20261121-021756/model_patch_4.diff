+/**
+ * Collect the event types of all known client information account data events
+ */
+const getClientInformationEventTypes = (matrixClient: MatrixClient): string[] => {
+    // account data is stored by event type in the client store (record or map depending on the store)
+    const accountData = matrixClient.store?.accountData as unknown as Record<string, unknown> | Map<string, unknown>;
+
+    const eventTypes: string[] = [];
+    if (accountData instanceof Map) {
+        for (const eventType of accountData.keys()) eventTypes.push(eventType as string);
+    } else if (accountData && typeof accountData === "object") {
+        eventTypes.push(...Object.keys(accountData));
+    }
+
+    return eventTypes.filter((eventType) => eventType.startsWith(CLIENT_INFORMATION_PREFIX));
+};
+
+/**
+ * Remove client information for devices that no longer exist
+ * @param validDeviceIds device ids of the devices that still exist
+ * @param matrixClient
+ */
+export const pruneClientInformation = (validDeviceIds: string[], matrixClient: MatrixClient): void => {
+    // do not prune anything while the devices are not loaded yet
+    if (!validDeviceIds.length) return;
+
+    for (const eventType of getClientInformationEventTypes(matrixClient)) {
+        // the device id is the last part of the event type
+        const deviceId = eventType.substring(CLIENT_INFORMATION_PREFIX.length);
+
+        if (!validDeviceIds.includes(deviceId)) {
+            matrixClient.deleteAccountData(eventType);
+        }
+    }
+};
