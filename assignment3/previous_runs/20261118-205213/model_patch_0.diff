@@ -0,0 +1,207 @@
+"""Scratch verification of the new author matching behaviour (temporary)."""
+from openlibrary.catalog.add_book.load_book import find_author, find_entity, import_author
+from openlibrary.mocks.mock_infobase import MockSite
+
+
+def seed(mock_site, num, name, **overrides):
+    rec = {
+        'key': f'/authors/OL{num}A',
+        'name': name,
+        'type': {'key': '/type/author'},
+    }
+    rec.update(overrides)
+    mock_site.save(rec)
+
+
+class TestTmp:
+    def test_name_and_dates(self, mock_site):
+        seed(mock_site, 1, 'Mark Twain', birth_date='1835', death_date='1910')
+        author = {'name': 'Mark Twain', 'birth_date': '1835', 'death_date': '1910'}
+        assert find_entity(author)['key'] == '/authors/OL1A'
+        assert len(find_author(author)) == 1
+
+    def test_wrong_dates_still_name_match(self, mock_site):
+        seed(mock_site, 1, 'Mark Twain', birth_date='1835', death_date='1910')
+        author = {'name': 'Mark Twain', 'birth_date': '1835', 'death_date': '1911'}
+        assert find_entity(author) is None
+        assert len(find_author(author)) == 1
+
+    def test_case_insensitive(self, mock_site):
+        seed(mock_site, 1, 'Mark Twain')
+        assert find_entity({'name': 'mark twain'})['key'] == '/authors/OL1A'
+        assert find_entity({'name': 'MARK TWAIN'})['key'] == '/authors/OL1A'
+
+    def test_wildcard_first_by_key(self, mock_site):
+        for i, name in ((10, 'John Smith'), (2, 'john smithes'), (7, 'Jane Doe')):
+            mock_site.save(
+                {
+                    'key': f'/authors/OL{i}A',
+                    'name': name,
+                    'type': {'key': '/type/author'},
+                }
+            )
+        author = {'name': 'John*'}
+        assert [a['key'] for a in find_author(author)] == ['/authors/OL2A', '/authors/OL10A']
+        assert find_entity(author)['key'] == '/authors/OL2A'
+
+    def test_no_match_returns_new_candidate(self, mock_site):
+        seed(mock_site, 1, 'Mark Twain')
+        author = {'name': 'John Doe*', 'birth_date': '1970'}
+        assert find_author(author) == []
+        candidate = import_author(author)
+        assert candidate['name'] == 'John Doe*'
+        assert candidate['birth_date'] == '1970'
+        assert candidate['type'] == {'key': '/type/author'}
+        assert 'key' not in candidate
+        assert find_entity(author) is None
+        assert find_entity({'name': 'John Doe'}) is None
+
+    def test_alternate_names(self, mock_site):
+        seed(mock_site, 1, 'Samuel Clemens', birth_date='1835', death_date='1910')
+        mock_site.save(
+            {
+                'key': '/authors/OL1A',
+                'name': 'Samuel Clemens',
+                'alternate_names': ['Mark Twain', 'QC 750'],
+                'birth_date': '1835',
+                'death_date': '1910',
+                'type': {'key': '/type/author'},
+            }
+        )
+        author = {
+            'name': 'Mark Twain',
+            'alternate_names': ['QC 750'],
+            'birth_date': '1835',
+            'death_date': '1910',
+        }
+        assert find_entity(author)['key'] == '/authors/OL1A'
+
+    def test_alternate_names_need_both_dates(self, mock_site):
+        mock_site.save(
+            {
+                'key': '/authors/OL1A',
+                'name': 'Samuel Clemens',
+                'alternate_names': ['Mark Twain'],
+                'birth_date': '1835',
+                'type': {'key': '/type/author'},
+            }
+        )
+        author = {
+            'name': 'Nobody Here',
+            'alternate_names': ['Mark Twain'],
+            'birth_date': '1835',
+            'death_date': '1910',
+        }
+        assert find_entity(author) is None
+        assert find_author(author) == []
+
+    def test_surname(self, mock_site):
+        mock_site.save(
+            {
+                'key': '/authors/OL1A',
+                'name': 'Joan Smith',
+                'surname': 'Smith',
+                'birth_date': '1900',
+                'death_date': '1980',
+                'type': {'key': '/type/author'},
+            }
+        )
+        author = {
+            'name': 'Someone Else',
+            'surname': 'Smith',
+            'birth_date': '1900',
+            'death_date': '1980',
+        }
+        assert find_entity(author)['key'] == '/authors/OL1A'
+
+    def test_surname_from_name(self, mock_site):
+        mock_site.save(
+            {
+                'key': '/authors/OL1A',
+                'name': 'Joan Smith',
+                'birth_date': '1900',
+                'death_date': '1980',
+                'type': {'key': '/type/author'},
+            }
+        )
+        author = {
+            'name': 'Someone Else',
+            'surname': 'Smith',
+            'birth_date': '1900',
+            'death_date': '1980',
+        }
+        assert find_entity(author)['key'] == '/authors/OL1A'
+        assert find_entity(author)['key'] == '/authors/OL1A'
+
+    def test_surname_from_inverted_name(self, mock_site):
+        mock_site.save(
+            {
+                'key': '/authors/OL2A',
+                'name': 'Smith, Joan',
+                'birth_date': '1900',
+                'death_date': '1980',
+                'type': {'key': '/type/author'},
+            }
+        )
+        author = {
+            'name': 'Someone Else',
+            'surname': 'Smith',
+            'birth_date': '1900',
+            'death_date': '1980',
+        }
+        assert find_entity(author)['key'] == '/authors/OL2A'
+
+    def test_surname_needs_both_dates(self, mock_site):
+        mock_site.save(
+            {
+                'key': '/authors/OL1A',
+                'name': 'Joan Smith',
+                'surname': 'Smith',
+                'birth_date': '1900',
+                'type': {'key': '/type/author'},
+            }
+        )
+        author = {
+            'name': 'Nobody',
+            'surname': 'Smith',
+            'birth_date': '1900',
+            'death_date': '1980',
+        }
+        assert find_entity(author) is None
+        assert find_author(author) == []
+
+    def test_one_date_missing_falls_back_to_name(self, mock_site):
+        seed(mock_site, 1, 'Mark Twain', birth_date='1835', death_date='1910')
+        # Only a birth date supplied
+        author = {'name': 'Mark Twain', 'birth_date': '1835'}
+        assert find_entity(author)['key'] == '/authors/OL1A'
+        # Only a death date supplied
+        author = {'name': 'Mark Twain', 'death_date': '1910'}
+        assert find_entity(author)['key'] == '/authors/OL1A'
+        # Existing record has no dates at all
+        seed(mock_site, 2, 'John Smith')
+        author = {'name': 'John Smith', 'birth_date': '1900'}
+        assert find_entity(author)['key'] == '/authors/OL2A'
+        # Conflicting supplied date still rejects
+        author = {'name': 'Mark Twain', 'birth_date': '1836'}
+        assert find_entity(author) is None
+
+    def test_year_only_comparison(self, mock_site):
+        seed(mock_site, 1, 'Mark Twain', birth_date='1835-11-30', death_date='1910-04-21')
+        author = {'name': 'Mark Twain', 'birth_date': '1835', 'death_date': '1910'}
+        assert find_entity(author)['key'] == '/authors/OL1A'
+        mock_site.save(
+            {
+                'key': '/authors/OL2A',
+                'name': 'Ann J. Smith',
+                'birth_date': 'fl. 1900',
+                'type': {'key': '/type/author'},
+            }
+        )
+        # 'fl. 1900' only matches on the year component
+        assert find_entity({'name': 'Ann*Smith', 'birth_date': '1900'})['key'] == '/authors/OL2A'
+
+    def test_new_author_via_import_author(self, mock_site):
+        rec = import_author({'name': 'John Doe*', 'birth_date': '1900'})
+        assert rec['name'] == 'John Doe*'
+        assert rec['birth_date'] == '1900'
