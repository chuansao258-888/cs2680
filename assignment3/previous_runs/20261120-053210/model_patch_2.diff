+// isKernelPackage reports whether the package belongs to the kernel
+// image/modules/devel families (including debug and rt variants).
+// kernel-adjacent packages such as kernel-tools, kernel-srpm-macros,
+// kernel-livepatch-*, perf, python-perf are not kernel packages.
+func isKernelPackage(name string) bool {
+	switch {
+	case name == "kernel",
+		name == "kernel-core",
+		name == "kernel-devel",
+		strings.HasPrefix(name, "kernel-modules"),
+		strings.HasPrefix(name, "kernel-debug"),
+		strings.HasPrefix(name, "kernel-rt"),
+		strings.HasPrefix(name, "kernel-uek"):
+		return true
+	}
+	return false
+}
+
+func isDebugKernelPackage(name string) bool {
+	return strings.Contains(name, "debug")
+}
+
+// isLegacyKernelReleaseFormat reports whether the distro release uses the
+// legacy kernel release format (without architecture suffix). Only known
+// major versions below the threshold are legacy: RHEL/CentOS/Oracle < 6 and
+// Fedora < 9. Alma, Rocky, Amazon and all other Red Hat family distros use
+// the modern format.
+func isLegacyKernelReleaseFormat(family string, release string) bool {
+	var minor int
+	switch family {
+	case constant.RedHat, constant.CentOS, constant.Oracle:
+		minor = 6
+	case constant.Fedora:
+		minor = 9
+	default:
+		return false
+	}
+	major, err := strconv.Atoi(strings.Split(release, ".")[0])
+	if err != nil {
+		return false
+	}
+	return major < minor
+}
