+// timeSearchV2Index returns the definition of the indexTimeSearchV2 global
+// secondary index. It is partitioned by the normalized event date, which
+// spreads the load across many partitions and allows efficient searches over
+// a range of days.
+func timeSearchV2Index() *dynamodb.GlobalSecondaryIndex {
+	return &dynamodb.GlobalSecondaryIndex{
+		IndexName: aws.String(indexTimeSearchV2),
+		KeySchema: []*dynamodb.KeySchemaElement{
+			{
+				AttributeName: aws.String(keyDate),
+				KeyType:       aws.String("HASH"),
+			},
+			{
+				AttributeName: aws.String(keyCreatedAt),
+				KeyType:       aws.String("RANGE"),
+			},
+		},
+		Projection: &dynamodb.Projection{
+			ProjectionType: aws.String("ALL"),
+		},
+	}
+}
+
+// createTimeSearchV2Index adds the indexTimeSearchV2 global secondary index to
+// an already existing events table, so that the date based searches can be
+// served from it.
+func (l *Log) createTimeSearchV2Index(tableName string) error {
+	index := timeSearchV2Index()
+	_, err := l.svc.UpdateTable(&dynamodb.UpdateTableInput{
+		TableName: aws.String(tableName),
+		GlobalSecondaryIndexUpdates: []*dynamodb.GlobalSecondaryIndexUpdate{
+			{
+				Create: &dynamodb.CreateGlobalSecondaryIndexAction{
+					IndexName:  index.IndexName,
+					KeySchema:  index.KeySchema,
+					Projection: index.Projection,
+					ProvisionedThroughput: &dynamodb.ProvisionedThroughput{
+						ReadCapacityUnits:  aws.Int64(l.ReadCapacityUnits),
+						WriteCapacityUnits: aws.Int64(l.WriteCapacityUnits),
+					},
+				},
+			},
+		},
+	})
+	if err != nil {
+		return trace.Wrap(convertError(err))
+	}
+	return nil
+}
+
+// migrateDateAttribute scans the events table and adds the CreatedAtDate
+// attribute (the date of the event creation in ISO 8601 format, yyyy-mm-dd) to
+// every event that does not have it yet, so that previously stored events
+// become queryable by date. It runs the whole pass to completion and honors
+// the cancellation of the supplied context.
+func (l *Log) migrateDateAttribute(ctx context.Context) error {
+	var lastEvaluatedKey map[string]*dynamodb.AttributeValue
+	for {
+		select {
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		default:
+		}
+		out, err := l.svc.Scan(&dynamodb.ScanInput{
+			TableName:         aws.String(l.Tablename),
+			ExclusiveStartKey: lastEvaluatedKey,
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		for _, item := range out.Items {
+			select {
+			case <-ctx.Done():
+				return trace.Wrap(ctx.Err())
+			default:
+			}
+			sessionID := item[keySessionID]
+			eventIndex := item[keyEventIndex]
+			createdAt := item[keyCreatedAt]
+			// not a valid event record, skip it
+			if sessionID == nil || eventIndex == nil || createdAt == nil ||
+				sessionID.S == nil || eventIndex.N == nil || createdAt.N == nil {
+				continue
+			}
+			seconds, err := strconv.ParseInt(aws.StringValue(createdAt.N), 10, 64)
+			if err != nil {
+				l.Debugf("Skipping event with invalid creation time %v: %v", aws.StringValue(createdAt.N), err)
+				continue
+			}
+			_, err = l.svc.UpdateItem(&dynamodb.UpdateItemInput{
+				TableName: aws.String(l.Tablename),
+				Key: map[string]*dynamodb.AttributeValue{
+					keySessionID:  {S: sessionID.S},
+					keyEventIndex: {N: eventIndex.N},
+				},
+				UpdateExpression:          aws.String("SET CreatedAtDate = :date"),
+				ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{":date": {S: aws.String(time.Unix(seconds, 0).UTC().Format(iso8601DateFormat))}},
+			})
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+		}
+		// DynamoDB returns a `lastEvaluatedKey` in case the response is
+		// truncated, the end of the table is signaled by not setting it.
+		lastEvaluatedKey = out.LastEvaluatedKey
+		if len(lastEvaluatedKey) == 0 {
+			return nil
+		}
+	}
+}
+
+// daysBetween returns a list with all the days, in ISO 8601 (yyyy-mm-dd)
+// format, that fall into the [fromUTC, toUTC] range. Both the day of the
+// start and the day of the end timestamps are included, so the returned list
+// also covers ranges that span month boundaries.
+func daysBetween(fromUTC, toUTC time.Time) []string {
+	fromDate := fromUTC.UTC()
+	toDate := toUTC.UTC()
+
+	var days []string
+	current := time.Date(fromDate.Year(), fromDate.Month(), fromDate.Day(), 0, 0, 0, 0, time.UTC)
+	end := time.Date(toDate.Year(), toDate.Month(), toDate.Day(), 0, 0, 0, 0, time.UTC)
+	for !current.After(end) {
+		days = append(days, current.Format(iso8601DateFormat))
+		current = current.AddDate(0, 0, 1)
+	}
+	return days
+}
