+/**
+ * Remove client information events for devices which no longer exist
+ * @param validDeviceIds - list of device ids that currently exist for the user
+ * @param matrixClient - client to use
+ */
+export const pruneClientInformation = (validDeviceIds: string[], matrixClient: MatrixClient): void => {
+    // avoid pruning whilst the list of devices for the user is empty,
+    // as we do not know which client information events are obsolete
+    if (!validDeviceIds?.length) {
+        return;
+    }
+
+    // iterate over client information events, remove events with unknown devices
+    const accountDataIndex = matrixClient.store?.accountData;
+    if (!accountDataIndex) {
+        return;
+    }
+
+    Object.keys(accountDataIndex).forEach((type: string): void => {
+        if (!type.startsWith(clientInformationPrefix)) {
+            return;
+        }
+
+        const deviceId = type.substring(clientInformationPrefix.length);
+        if (!validDeviceIds.includes(deviceId)) {
+            matrixClient.deleteAccountData(type);
+        }
+    });
+};
+
 const sanitizeContentString = (value: unknown): string | undefined =>
