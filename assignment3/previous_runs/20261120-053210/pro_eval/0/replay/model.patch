+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """
+        Constructs a regex pattern for the ILIKE operation and matches it
+        against the given text.
+
+        Replicates the ILIKE semantics of the production database: the match
+        is case-insensitive and must span the whole string, ``*`` acts as a
+        multi-character wildcard and ``_`` is ignored, i.e. it is *not* a
+        single character wildcard but an ordinary character.
