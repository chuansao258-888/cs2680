+        :param str pattern: e.g. "John*"
+        :param str text: e.g. "Johnson, Jane"
+        :return: True if text matches pattern, False otherwise
+        """
+        # Escape regex metacharacters so that only '*' gets wildcard meaning.
+        escaped = re.escape(pattern).replace(r'\*', '.*')
+        return bool(re.fullmatch(escaped, text, flags=re.IGNORECASE))
