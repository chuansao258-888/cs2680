+/**
+ * Remove client information events for devices that no longer exist.
+ * Iterates through the Matrix client's account data and deletes any client
+ * information entries whose device IDs are not in the list of valid device IDs.
+ * @param validDeviceIds - list of the user's device ids that still exist
+ * @param matrixClient - matrix client
+ */
+export function pruneClientInformation(validDeviceIds: string[], matrixClient: MatrixClient): void {
+    // do nothing when the devices are not loaded yet
+    if (!validDeviceIds.length) {
+        return;
+    }
+
+    // @ts-ignore getAccountData returns all account data events when called without an event type
+    const events: Record<string, unknown> | undefined = matrixClient.getAccountData();
+    if (!events) {
+        return;
+    }
+
+    for (const eventType of Object.keys(events)) {
+        if (!eventType.startsWith(CLIENT_INFORMATION_PREFIX)) {
+            continue;
+        }
+
+        const deviceId = eventType.substring(CLIENT_INFORMATION_PREFIX.length);
+        if (!validDeviceIds.includes(deviceId)) {
+            matrixClient.deleteAccountData(eventType);
+        }
+    }
+}
