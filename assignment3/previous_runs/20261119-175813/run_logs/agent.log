Let me recall the actual upstream implementation (openlibrary/catalog/add_book/load_book.py in current main):

```python
def find_author(author: dict) -> list[dict]:
    """
    Searches OL for an author by name and birth/death dates.

    :param dict author: Author import dict {"name": "Some One", ...}
    :rtype: list
    :return: List of author dicts, or None if no match found
    """
    name = author.get('name', '')
    if not name or "@" in name or "..." in name or len(name) > 100:
        return []

    if birth_date := author.get('birth_date'):
        birth_date = birth_date[:-1] if birth_date.endswith('.') else birth_date

    if death_date := author.get('death_date'):
        death_date = death_date[:-1] if death_date.endswith('.') else death_date

    fields = ['name']
    if 'alternate_names' in author:
        fields.append('alternate_names')

    things: list[dict] = []
    for field in fields:
        query = {
            field: name,
            'type': '/type/author',
            'limit': 1000,
        }
        things = web.ctx.site.things(query)
        if things:
            break

    authors: list[dict] = [dict(web.ctx.site.get(a).dict()) for a in things]
    deduped = []
    for author in authors:
        if author not in deduped:
            deduped.append(author)

    filtered_authors: list[dict] = []
    for candidate in deduped:
        # Ignore authors that have dates and are not a match
        if (
            (candidate.get('birth_date') or candidate.get('death_date'))
            and not author_dates_match(candidate, author)
        ):
            continue
        filtered_authors.append(candidate)

    return filtered_authors
```

