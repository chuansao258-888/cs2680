def author_date_year(date: str | None) -> str | None:
    """Extracts the (birth or death) year from an author date, e.g. '1918.' -> '1918'."""
    if not date:
        return None
    m = re_year_dot.search(date)
    return m.group(1) if m else None


def have_both_dates(author: dict) -> bool:
    return bool(author.get('birth_date')) and bool(author.get('death_date'))


def candidate_dates_match(candidate, birth_date, death_date) -> bool:
    """
    Compares (import) birth/death years against an author record (or candidate).
    A missing year on either side is treated as unknown, i.e. compatible.
    """
    for candidate_key, year in (
        ('birth_date', birth_date),
        ('death_date', death_date),
    ):
        candidate_year = author_date_year(candidate.get(candidate_key))
        if year and candidate_year and year != candidate_year:
            return False
    return True
```

