import re

    @staticmethod
    def regex_ilike(pattern: str, text: str) -> bool:
        """
        Emulate the behavior of the production ILIKE query operator.

        Pattern matching is case-insensitive, ``*`` acts as a multi-character
        wildcard, and ``_`` is ignored in the pattern.
        """
        if not isinstance(text, str):
            return False
        regex = '^'
        for token in re.split(r'(\*)', pattern):
            if token == '*':
                regex += '.*'
            elif token:
                regex += re.escape(token.replace('_', ''))
        regex += '$'
        return bool(re.match(regex, text, re.IGNORECASE))
```

