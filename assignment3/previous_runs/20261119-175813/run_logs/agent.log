def find_author(author: dict) -> list[dict[str, Any]]:
    """
    Search Open Library for possible matches to an author import record.

    Matches are attempted, in order of decreasing precedence:
      1. on the author name, together with birth and death dates,
      2. on alternate_names, together with birth and death dates,
      3. on the surname, together with birth and death dates.
    All name matching is case-insensitive.

    Returns a list of candidate author records, or an empty list if
    there is no match.
    """
    name = author.get('name')
    if not name:
        return []
    birth_date = author.get('birth_date')
    death_date = author.get('death_date')
    # An exact match on name plus both dates takes precedence over everything else
    if birth_date and death_date:
        if found := search_by_name(name, birth_date, death_date):
            return found
    # Fall back to (case-insensitive) name matching alone
    if found := search_by_name(name):
        return found
    if birth_date and death_date:
        # then try to match on alternate names...
        if found := search_by_alternate_names(name, birth_date, death_date):
            return found
        # last attempt: match on surname
        if found := search_by_surname(name, birth_date, death_date):
            return found
    return []
