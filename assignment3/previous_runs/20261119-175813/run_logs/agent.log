```python
def find_author(author: dict) -> list[dict]:
    """
    Searches OL for an author matching an import author record.

    Matching is attempted, in order of decreasing confidence:
      1. the author's name together with their birth and death dates,
      2. the author's alternate names together with their birth and death dates,
      3. the author's surname together with their birth and death dates,
      4. the author's name alone.

    All name comparisons are case-insensitive and support the ``*`` wildcard,
    mirroring how PostgreSQL's ILIKE behaves in production.

    :param dict author: Author import representation, eg. {'name': '...'}
    :rtype: list
    :return: A list of existing OL authors, or a list with the new author candidate
    """
    name = author.get('name') or ''
    if not name:
        return []
    dates = get_dates(author)
    both_dates = bool(dates)
    if both_dates:
        if matches := find_author_by_name_and_dates(name, dates):
            return matches
        if matches := find_author_by_alternate_names(author, dates):
            return matches
        if matches := find_author_by_surname(author, dates):
            return matches
    # Fall back to a case-insensitive search on the name alone.
    return find_name(name)
```

