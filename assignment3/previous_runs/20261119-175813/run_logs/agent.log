```python
    @staticmethod
    def regex_ilike(pattern: str, text: str) -> bool:
        """
        Emulate the behaviour of a PostgreSQL ``ILIKE`` comparison, as used by
        infogami for the ``~`` query operator, i.e. case-insensitive matching of
        ``text`` against the SQL ``pattern`` where ``*`` acts as a multi-character
        wildcard (like ``%``) and ``_`` is *not* a wildcard.
        """
        if text is None:
            return False
        regex = ''.join(
            '.*' if c == '*' else re.escape(c) for c in pattern.lower()
        )
        return re.fullmatch(regex, str(text).lower(), re.DOTALL) is not None
```

