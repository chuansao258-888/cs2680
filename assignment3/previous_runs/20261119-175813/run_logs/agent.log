def get_year(date: Any) -> str | None:
    """Return the four digit year of a date string, i.e. '1845.' -> '1845'."""
    if not date:
        return None
    match = re.search(r'\d{1,4}', str(date))
    return match.group(0).lstrip('0') or None  # hmm
```

