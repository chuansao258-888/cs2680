def find_author(author: dict) -> list[dict]:
    if not (name := author.get('name')):
        return []

    birth_date = author.get('birth_date')
    death_date = author.get('death_date')
    has_dates = bool(birth_date and death_date)

    # 1. Match on the name together with the birth and death dates.
    if candidates := _match_authors(build_name_query(name), birth_date, death_date):
        return candidates

    if has_dates:
        # 2. Match on alternate names together with the birth and death dates.
        alternate_names = {name, *(author.get('alternate_names') or [])}
        for alternate_name in alternate_names:
            if candidates := _match_authors(
                build_name_query(alternate_name), birth_date, death_date, require_dates=True
            ):
                return candidates

        # 3. Match on the surname together with the birth and death dates.
        if surname := get_surname(name):
            if candidates := _match_authors({'name~': f'*{surname}', 'type': '/type/author', 'limit': 1000}, birth_date, death_date, require_dates=True):
                return candidates

    # Fall back to matching on the name alone (case-insensitively).
    return _match_authors(build_name_query(name))
```

