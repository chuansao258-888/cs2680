```python
def find_entity(author):
    name = author['name']
    et = author.get('entity_type')
    has_dates = bool(author.get('birth_date') and author.get('death_date'))

    def search(field, value, *, exact_dates):
        """Case-insensitive search of `field` for `value`, requiring exact
        birth and death years when `exact_dates`."""
        patterns = [wildcard(value)]
        if ', ' in value:
            patterns.append(wildcard(flip_name(value)))
        found, seen = [], set()
        for pattern in patterns:
            for a in get_author_things({field: pattern, 'type': '/type/author'}):
                if not field_matches(a, field, pattern):
                    continue
                if a['key'] in seen:
                    continue
                if not dates_are_consistent(author, a):
                    continue
                if exact_dates and not dates_match(author, a):
                    continue
                seen.add(a['key'])
                found.append(a)
        return found
```

