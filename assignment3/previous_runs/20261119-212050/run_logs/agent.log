def find_author(name: str) -> list[dict]:
    """
    Searches OL for an author by name.
    """

    def walk_redirects(obj: dict, seen: set) -> dict | None:
        seen.add(obj['key'])
        while obj['type']['key'] == '/type/redirect':
            assert obj['location'] != obj['key']
            obj = web.ctx.site.get(obj['location'])
            if obj['key'] in seen:
                return None
            seen.add(obj['key'])
        return obj

    q = {'type': '/type/author', 'name': name}
    reply = [web.ctx.site.get(k) for k in web.ctx.site.things(q)]
    if any(a and a.type.key != '/type/author' for a in reply):
        seen: set = set()
        authors = [walk_redirects(a, seen) for a in reply if a]
        reply = [a for a in authors if a]
    return reply
```

