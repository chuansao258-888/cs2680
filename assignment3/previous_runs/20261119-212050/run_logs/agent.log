Design:

```
def find_entity(author):
    name = author['name']
    et = author.get('entity_type')

    def candidates(field: str, value: str, *, exact_dates: bool) -> list:
        """Author records whose `field` matches `value`, case-insensitively."""
        found, seen = [], set()
        for pattern in wildcard_patterns(value):   # value + flipped variant
            for a in get_author_things({field: pattern, 'type': '/type/author'}):
                if not field_matches(a, field, pattern):
                    continue
                if not dates_are_consistent(author, a):
                    continue
                if exact_dates and not dates_match(author, a):
                    continue
                if a['key'] not in seen:
                    seen.add(a['key'])
                    found.append(a)
        return sort_by_key(found)

    # 1. name + birth/death dates
    things = candidates('name', name, exact_dates=False)
    if things:
        # records which exactly match on both dates take precedence
        dated = [a for a in things if dates_match(author, a)]
        return dated[0] if dated else things[0]

    # non-person entities (orgs) are only ever matched by name
    if et and et != 'person':
        return None

    # 2. alternate_names + birth/death dates
    if dates are present:
      for alt in author.get('alternate_names') or []:
        things = candidates('alternate_names', alt, exact_dates=True)
        if things: return things[0]
      # 3. surname + birth/death dates
      if surname := get_surname(name):
         things = candidates('name', surname, exact_dates=True)   # with word-boundary-ish check
         if things: return things[0]
    return None
```

