+
+// isKernelPackage returns whether the package is a kernel package
+// (kernel image, modules, devel, debug or rt variant).
+func isKernelPackage(name string) bool {
+	if name == "kernel" {
+		return true
+	}
+	for _, prefix := range kernelPackagePrefixes {
+		if strings.HasPrefix(name, prefix) {
+			return true
+		}
+	}
+	return false
+}
+
+// isDebugKernelPackage returns whether the kernel package is a debug variant.
+func isDebugKernelPackage(name string) bool {
+	return strings.Contains(name, "debug")
+}
+
+// isDebugRunningKernel returns whether the running kernel is a debug kernel.
+func isDebugRunningKernel(kernelRelease string) bool {
+	return strings.HasSuffix(kernelRelease, "debug")
+}
+
+// hasArchInKernelRelease returns whether the release string of the running
+// kernel contains the architecture, e.g. "5.14.0-427.13.1.el9_4.x86_64".
+// RHEL 6(or later), Alma, Rocky, Amazon, Fedora 9(or later) show the arch.
+// If the distro release is unknown, the modern format is expected.
+func hasArchInKernelRelease(family, release string) bool {
+	major, err := config.Distro{Family: family, Release: release}.MajorVersion()
+	if err != nil {
+		return true
+	}
+	switch family {
+	case constant.RedHat, constant.CentOS, constant.Oracle:
+		return 6 <= major
+	case constant.Fedora:
+		return 9 <= major
+	}
+	return true
+}
