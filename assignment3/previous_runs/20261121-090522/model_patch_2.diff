+// kernelPackagePrefixes are the package names (or name prefixes) that provide
+// the kernel image, the kernel modules or the kernel devel files.
+// Packages such as kernel-tools, kernel-srpm-macros, perf, python-perf are not
+// kernel packages: they are not bound to a concrete kernel release and have to
+// be kept in the scan result whatever the running kernel is.
+var kernelPackagePrefixes = []string{
+	"kernel-core",
+	"kernel-modules",
+	"kernel-devel",
+	"kernel-debug",
+	"kernel-rt",
+	"kernel-uek",
