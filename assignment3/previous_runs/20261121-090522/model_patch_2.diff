+func TestIsKernelPackageDetection(t *testing.T) {
+	tests := []struct {
+		name string
+		pack models.Package
+		want bool
+	}{
+		{"kernel", models.Package{Name: "kernel"}, true},
+		{"kernel-core", models.Package{Name: "kernel-core"}, true},
+		{"kernel-modules", models.Package{Name: "kernel-modules"}, true},
+		{"kernel-modules-extra", models.Package{Name: "kernel-modules-extra"}, true},
+		{"kernel-devel", models.Package{Name: "kernel-devel"}, true},
+		{"kernel-debug", models.Package{Name: "kernel-debug"}, true},
+		{"kernel-debug-core", models.Package{Name: "kernel-debug-core"}, true},
+		{"kernel-debug-modules", models.Package{Name: "kernel-debug-modules"}, true},
+		{"kernel-debug-modules-extra", models.Package{Name: "kernel-debug-modules-extra"}, true},
+		{"kernel-rt", models.Package{Name: "kernel-rt"}, true},
+		{"kernel-rt-core", models.Package{Name: "kernel-rt-core"}, true},
+		{"kernel-rt-debug-modules-extra", models.Package{Name: "kernel-rt-debug-modules-extra"}, true},
+		{"kernel-uek", models.Package{Name: "kernel-uek"}, true},
+		{"kernel-uek-modules", models.Package{Name: "kernel-uek-modules"}, true},
+		{"kernel-tools", models.Package{Name: "kernel-tools"}, false},
+		{"kernel-tools-libs", models.Package{Name: "kernel-tools-libs"}, false},
+		{"kernel-srpm-macros", models.Package{Name: "kernel-srpm-macros"}, false},
+		{"kernel-livepatch-4_18_0-513", models.Package{Name: "kernel-livepatch-4_18_0-513"}, false},
+		{"kernel-livepatch-tools", models.Package{Name: "kernel-livepatch-tools"}, false},
+		{"perf", models.Package{Name: "perf"}, false},
+		{"python-perf", models.Package{Name: "python-perf"}, false},
+		{"openssl", models.Package{Name: "openssl"}, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := isKernelPackage(tt.pack.Name); got != tt.want {
+				t.Errorf("isKernelPackage(%s) = %v, want %v", tt.pack.Name, got, tt.want)
+			}
+		})
+	}
+}
