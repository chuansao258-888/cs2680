+/**
+ * Remove client information for devices that no longer exist
+ *
+ * @param validDeviceIds device ids to keep information for
+ * @param matrixClient
+ */
+export const pruneClientInformation = (validDeviceIds: string[], matrixClient: MatrixClient): void => {
+    // Do nothing if we don't have a valid list of devices
+    // (eg. the device list has not been loaded yet)
+    if (!validDeviceIds?.length) {
+        return;
+    }
+
+    const accountData = matrixClient.store?.accountData as
+        | Record<string, MatrixEvent>
+        | Map<string, MatrixEvent>
+        | MatrixEvent[]
+        | undefined;
+
+    if (!accountData) {
+        return;
+    }
+
+    let eventTypes: string[];
+    if (Array.isArray(accountData)) {
+        eventTypes = accountData.map((event) => event?.getType?.()).filter((type) => !!type) as string[];
+    } else if (accountData instanceof Map) {
+        eventTypes = [...accountData.keys()].map((key) => `${key}`);
+    } else {
+        eventTypes = Object.keys(accountData);
+    }
+
+    for (const eventType of eventTypes) {
+        if (!eventType.startsWith(CLIENT_INFORMATION_PREFIX)) {
+            continue;
+        }
+
+        const deviceId = eventType.substring(CLIENT_INFORMATION_PREFIX.length);
+        if (!validDeviceIds.includes(deviceId)) {
+            matrixClient.deleteAccountData(eventType);
+        }
+    }
+};
+
 const sanitizeContentString = (value: unknown): string | undefined =>
     value && typeof value === "string" ? value : undefined;
 
